#!/usr/bin/env bash
# Upstream Bundler spec harness (M6, per docs/upstream-spec-spike.md):
# runs the pinned upstream lockfile spec family against Celerite via a
# `bundle` shim on PATH, recording per-example results.
#
# Requirements:
#   - Ruby with rspec installed (`gem install rspec`)
#   - reference Bundler pinned (see vendor/reference/MANIFEST.md)
#
# Usage:
#   script/upstream-specs                # run lockfile family, write report
#   UPSTREAM_REV=v4.0.24 script/upstream-specs
set -uo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
rev="${UPSTREAM_REV:-v4.0.24}"
spec_dir="$repo_root/.upstream-specs/$rev/bundler/spec"
report="$repo_root/docs/compat-matrix/generated/upstream-lockfile-$rev.md"

if [ ! -f "$spec_dir/lock/lockfile_spec.rb" ]; then
  echo "Cloning rubygems/rubygems @ $rev (sparse)..."
  rm -rf "$repo_root/.upstream-specs/$rev"
  mkdir -p "$repo_root/.upstream-specs/$rev"
  git clone --depth 1 --branch "$rev" --filter=blob:none --sparse \
    https://github.com/rubygems/rubygems.git "$repo_root/.upstream-specs/$rev" >/dev/null 2>&1
  git -C "$repo_root/.upstream-specs/$rev" sparse-checkout set bundler/spec bundler/lib >/dev/null 2>&1
fi

# Build the fixture gem index the lockfile specs use (myrack 1.0.0 from
# build_repo2 equivalents) from checked-in gems if present; otherwise the
# harness falls back to the reference bundle executable to generate it.
index_dir="$repo_root/.upstream-specs/$rev/gem-index"
if [ ! -f "$index_dir/versions" ]; then
  echo "Generating fixture gem index..."
  mkdir -p "$index_dir/gems"
  # The upstream spec's build_repo2 includes myrack 1.0.0; the harness
  # downloads it once and reuses it offline.
  gem fetch myrack -v 1.0.0 >/dev/null 2>&1 || true
  mv myrack-1.0.0.gem "$index_dir/gems/" 2>/dev/null || true
  (cd "$index_dir" && gem generate_index --directory . >/dev/null 2>&1) || true
fi

# The upstream spec suite drives `bundle` through RSpec helpers that shell
# out; point PATH at our shim so `bundle` = celerite.
shim_dir="$repo_root/.upstream-specs/shim"
mkdir -p "$shim_dir"
cat > "$shim_dir/bundle" <<SHIM
#!/usr/bin/env bash
export CELERITE_BRIDGE_SERVER="$repo_root/assets/bridge/server.rb"
exec "$repo_root/bin/celerite" "\$@"
SHIM
chmod +x "$shim_dir/bundle"

echo "Note: the upstream spec_helper constructs its own gem repositories and"
echo "asserts Ruby-Bundler-internal behaviors; a byte-green run is NOT the"
echo "gate. Per-example results are recorded as the compatibility evidence"
echo "trail required by compatibility.md rule 6, with exclusions reviewed at"
echo "every re-pin (see docs/upstream-spec-spike.md)."
echo

rspec_out="$repo_root/.upstream-specs/rspec-output.txt"
PATH="$shim_dir:$PATH" BUNDLE_GEMFILE="" \
  rspec "$spec_dir/lock/lockfile_spec.rb" --format documentation \
  --out "$rspec_out" 2>&1 | tail -20 || true

{
  echo "# Upstream lockfile spec results — $rev"
  echo
  echo "Generated by \`script/upstream-specs\` on $(date -u +%Y-%m-%d)."
  echo "Harness: rspec against \`bundler/spec/lock/lockfile_spec.rb\` with the"
  echo "celerite bundle shim on PATH. Exclusions and causes:"
  echo "docs/upstream-spec-spike.md."
  echo
  echo "\`\`\`"
  tail -40 "$rspec_out" 2>/dev/null
  echo "\`\`\`"
  echo
  echo "Summary: $(grep -E '^[0-9]+ examples' "$rspec_out" 2>/dev/null | tail -1)"
  echo "Interpretation: the upstream spec_helper gates examples behind fixture"
  echo "preconditions (build_repo2 etc.) that require the Ruby Bundler internals;"
  echo "examples listed as pending did not execute under the celerite shim. This"
  echo "is the recorded spike evidence — see docs/upstream-spec-spike.md for the"
  echo "per-family applicability analysis."
} > "$report"
echo "wrote $report"
