#!/usr/bin/env bash
# Upstream Bundler spec harness (M7, per docs/upstream-spec-spike.md):
# runs the pinned upstream lockfile spec family against Celerite via a
# `bundle` shim on PATH, recording per-example results.
#
# Requirements:
#   - Ruby with rspec installed (`gem install rspec`)
#   - built `bin/celerite` (or `bin/celerite.exe` on Windows)
#   - network access on first run to sparse-clone rubygems/rubygems and fetch
#     the myrack fixture gem; vendored compact_index may be fetched by upstream
#     spec setup if the full upstream suite bootstrap runs
#
# Usage:
#   script/upstream-specs                # run lockfile family, write report
#   UPSTREAM_REV=v4.0.24 script/upstream-specs
#   CELERITE_SKIP_TEST_DEPS=1 script/upstream-specs  # skip upstream install_test_deps
#
# Notes:
# - Real-drive is the DEFAULT: the helper override
#   (script/upstream-specs-celerite-override.rb) routes Bundler's in-example
#   `bundle` calls to Celerite. Set CELERITE_BUNDLE_HELPER_OVERRIDE=0 to fall
#   back to the baseline run (upstream binstubs, which do NOT drive celerite).
# - The upstream lockfile specs are written for Bundler's own test harness
#   (spec_helper/builders/helpers, tmp gem repos, installed bundle bin in test
#   gem path). A byte-green run is NOT the gate. This script records per-example
#   results/classification evidence (compatibility.md rule 6).
# - Exits non-zero if rspec reports failures/errors so CI/callers can see the
#   baseline truth; the generated report is still written.
# - The harness also proves its own preconditions before trusting an rspec exit
#   status (task-148): it counts real celerite invocations through a counter file
#   written by the shim and by the helper override, and it refuses to accept
#   "0 examples" as a result.
#
# Exit codes (task-148; the report is still written for every code except 69/70
# pre-rspec aborts):
#   0                     suite ran, drove celerite, and was byte-green
#   <rspec status> (1..N) suite drove celerite and upstream examples failed
#                         (baseline truth; 1 is the ordinary "red" case)
#   69 (EX_UNAVAILABLE)   environment/checkout unusable: the upstream suite ran
#                         0 examples, or the sparse checkout is incomplete even
#                         after a re-fetch. Distinguishes "never ran" from
#                         "ran and failed" and blocks the fake 0-example report.
#   70 (EX_SOFTWARE)      suite ran examples but did not drive celerite at all
#                         (real-drive counter == 0): harness/helper wiring broke.
#   127                   celerite binary not found (unchanged).
#
# NOTE: exit 1 is overloaded on purpose - it is rspec's own red status for a
# genuine baseline run. Callers that must tell "upstream red" from "harness
# broken" should test for 69/70 explicitly; both are outside rspec's 0..N
# range because rspec cannot exit above 255-sample counts in practice and never
# uses these two codes itself.
set -uo pipefail

# --- exit-code semantics (task-148) -----------------------------------------
exit_env_unusable=69 # EX_UNAVAILABLE: suite did not run / checkout unusable
exit_not_driving=70  # EX_SOFTWARE: suite ran but never invoked celerite

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
rev="${UPSTREAM_REV:-v4.0.24}"
spec_dir="$repo_root/.upstream-specs/$rev/bundler/spec"
# Curated evidence doc docs/compat-matrix/generated/upstream-lockfile-<rev>.md
# is appended by hand; this harness must not write docs/ (策展文档由人工追加).
report_dir="$repo_root/.upstream-specs"
mkdir -p "$report_dir"
report="$report_dir/upstream-lockfile-$rev-$(date -u +%Y%m%dT%H%M%SZ).md"

# Resolve celerite binary (Windows Crystal builds produce .exe).
celerite_bin="$repo_root/bin/celerite"
if [ ! -x "$celerite_bin" ] && [ -x "$repo_root/bin/celerite.exe" ]; then
  celerite_bin="$repo_root/bin/celerite.exe"
elif [ ! -f "$celerite_bin" ] && [ -f "$repo_root/bin/celerite.exe" ]; then
  celerite_bin="$repo_root/bin/celerite.exe"
fi

if [ ! -f "$celerite_bin" ]; then
  echo "error: celerite binary not found at $repo_root/bin/celerite(.exe)" >&2
  echo "hint: run 'shards build' and re-run this script" >&2
  exit 127
fi

# Older in-scope revisions (e.g. v2.7.2) carry `bundler/` as a git submodule
# (rubygems/rubygems `.gitmodules` -> https://github.com/bundler/bundler.git)
# instead of as tracked files. A sparse checkout cannot materialise a gitlink,
# so `bundler/lib` and `bundler/spec` stay absent however the patterns are set,
# and rspec dies with LoadError - the exact 0-example shape this pre-check
# exists to catch. Initialise the submodule when the tree declares one.
init_bundler_submodule() {
  _submodule_entry="$(git -C "$checkout_root" ls-files -s -- bundler 2>/dev/null || true)"
  case "$_submodule_entry" in
    160000*)
      echo "initialising upstream bundler submodule (gitlink in $rev)"
      git -C "$checkout_root" submodule update --init --depth 1 bundler >/dev/null 2>&1 || true
      ;;
  esac
}

if [ ! -f "$spec_dir/lock/lockfile_spec.rb" ]; then
  echo "Cloning rubygems/rubygems @ $rev (sparse)..."
  rm -rf "$repo_root/.upstream-specs/$rev"
  mkdir -p "$repo_root/.upstream-specs/$rev"
  git clone --depth 1 --branch "$rev" --filter=blob:none --sparse \
    https://github.com/rubygems/rubygems.git "$repo_root/.upstream-specs/$rev" >/dev/null 2>&1
  git -C "$repo_root/.upstream-specs/$rev" sparse-checkout set \
    bundler/spec bundler/lib bundler/bin bundler/exe >/dev/null 2>&1
else
  # Ensure bin/exe are present for dev_binstub/path resolution in spec support.
  git -C "$repo_root/.upstream-specs/$rev" sparse-checkout add bundler/bin bundler/exe >/dev/null 2>&1 || true
fi
checkout_root="$repo_root/.upstream-specs/$rev"
init_bundler_submodule

# --- checkout integrity pre-check (task-148) --------------------------------
# An existing spec file does NOT imply a usable checkout: a sparse checkout can
# leave bundler/lib (or bundler/bin, bundler/exe) missing or empty on disk while
# spec/lock/lockfile_spec.rb is present. That state loads spec_helper against a
# half-populated bundler tree and rspec dies with LoadError, producing
# "0 examples, 0 failures, 1 error occurred outside of examples" - a fake report
# that looks like a clean-ish run. Verify the checkout, repair it once (re-apply
# sparse-checkout, then re-clone as a last resort), and abort with a distinct
# exit code if it is still broken.
checkout_ok=1
# checkout_root is set above (the submodule initialiser is defined against it).
# Files whose absence/emptiness proves the sparse checkout did not land.
checkout_markers=(
  "bundler/lib/bundler.rb"
  "bundler/lib/bundler/version.rb"
  "bundler/spec/lock/lockfile_spec.rb"
  "bundler/spec/support/helpers.rb"
)

checkout_missing() {
  _missing=""
  for _marker in "${checkout_markers[@]}"; do
    if [ ! -s "$checkout_root/$_marker" ]; then
      _missing="$_missing $_marker"
    fi
  done
  # bundler/bin and bundler/exe must exist and be non-empty directories.
  for _dir in bundler/bin bundler/exe; do
    if [ ! -d "$checkout_root/$_dir" ] || [ -z "$(find "$checkout_root/$_dir" -mindepth 1 -print -quit 2>/dev/null)" ]; then
      _missing="$_missing $_dir/"
    fi
  done
  printf '%s' "$_missing"
}

repair_checkout() {
  echo "repairing incomplete upstream checkout: $checkout_root" >&2
  echo "  missing:$1" >&2
  # 1st attempt: re-apply the sparse-checkout patterns (cheap, no re-clone).
  git -C "$checkout_root" sparse-checkout set \
    bundler/spec bundler/lib bundler/bin bundler/exe >/dev/null 2>&1 || true
  git -C "$checkout_root" checkout -- . >/dev/null 2>&1 || true
  missing_after="$(checkout_missing)"
  if [ -z "$missing_after" ]; then
    echo "  repaired via sparse-checkout re-apply" >&2
    return 0
  fi
  # 2nd attempt: re-initialise the bundler submodule when the tree declares one
  # (a gitlink never lands via sparse-checkout), then fall back to a re-clone.
  init_bundler_submodule
  missing_after="$(checkout_missing)"
  if [ -z "$missing_after" ]; then
    echo "  repaired via bundler submodule init" >&2
    return 0
  fi
  echo "  submodule init insufficient (still missing:$missing_after); re-cloning" >&2
  rm -rf "$checkout_root"
  mkdir -p "$checkout_root"
  git clone --depth 1 --branch "$rev" --filter=blob:none --sparse \
    https://github.com/rubygems/rubygems.git "$checkout_root" >/dev/null 2>&1 || true
  git -C "$checkout_root" sparse-checkout set \
    bundler/spec bundler/lib bundler/bin bundler/exe >/dev/null 2>&1 || true
  init_bundler_submodule
  missing_after="$(checkout_missing)"
  if [ -z "$missing_after" ]; then
    echo "  repaired via fresh clone" >&2
    return 0
  fi
  echo "error: upstream checkout at $checkout_root is incomplete and could not be repaired (still missing:$missing_after)" >&2
  echo "hint: check network access to github.com/rubygems/rubygems and retry, or remove $checkout_root and re-run" >&2
  return 1
}

missing="$(checkout_missing)"
if [ -n "$missing" ]; then
  echo "upstream checkout incomplete:$missing" >&2
  if repair_checkout "$missing"; then
    checkout_ok=1
  else
    checkout_ok=0
  fi
fi

if [ "$checkout_ok" -ne 1 ]; then
  echo "error: refusing to run the upstream suite against an incomplete checkout ($checkout_root)" >&2
  echo "       no report written: a 0-example LoadError report is not evidence of compatibility" >&2
  exit $exit_env_unusable
fi

# Record what the checkout claims to be, so a stale/unrelated tree cannot pass
# silently as the requested revision. This is also the cheap gate for a missing
# `git`: the upstream suite shells out to `git --version` from
# `bundler/spec/support/filters.rb:21`, and with no git on PATH that raises
# Errno::ENOENT during suite setup. rspec then reports "0 examples, 0 failures,
# 1 error occurred outside of examples" and the harness used to write that up as
# a tidy-looking report whose non-zero exit came only from rspec counting the
# load error. Fail here instead: a run that cannot read its own checkout HEAD is
# an unusable environment, not an upstream failure.
if ! command -v git >/dev/null 2>&1; then
  echo "error: git is not on PATH, but the upstream suite requires it" >&2
  echo "       (bundler/spec/support/filters.rb:21 runs 'git --version'; without it" >&2
  echo "        rspec loads 0 examples and reports no real compatibility evidence)" >&2
  echo "       add git to PATH and re-run" >&2
  exit $exit_env_unusable
fi
checkout_rev="$(git -C "$checkout_root" rev-parse HEAD 2>/dev/null || echo unknown)"
if [ "$checkout_rev" = "unknown" ]; then
  echo "error: cannot read HEAD of the upstream checkout at $checkout_root" >&2
  echo "       (not a git work tree, or git failed); refusing to run the suite" >&2
  exit $exit_env_unusable
fi
echo "upstream checkout integrity: ok (HEAD $checkout_rev)"

# Build the fixture gem index the lockfile specs use (myrack 1.0.0 from
# build_repo2 equivalents) from checked-in gems if present; otherwise the
# harness falls back to the reference bundle executable to generate it.
index_dir="$repo_root/.upstream-specs/$rev/gem-index"
if [ ! -f "$index_dir/versions" ] && [ ! -f "$index_dir/specs.4.8" ]; then
  echo "Generating fixture gem index..."
  mkdir -p "$index_dir/gems"
  # The upstream spec's build_repo2 includes myrack 1.0.0; the harness
  # downloads it once and reuses it offline.
  gem fetch myrack -v 1.0.0 >/dev/null 2>&1 || true
  mv myrack-1.0.0.gem "$index_dir/gems/" 2>/dev/null || true
  (cd "$index_dir" && gem generate_index --directory . >/dev/null 2>&1) || true
fi

# The upstream spec suite drives `bundle` through RSpec helpers that shell
# out; point PATH at our shim so `bundle` = celerite. Upstream helpers also
# execute bundle via installed_bindir/dev_binstub paths inside the test env,
# so PATH shimming alone is insufficient for true in-example driving; see
# docs/upstream-spec-spike.md for the classification of this limitation.
shim_dir="$repo_root/.upstream-specs/shim"
mkdir -p "$shim_dir"
# Real-drive counter (task-148): the shim and the helper override both append a
# line here for every celerite process they launch, so the harness can prove it
# drove celerite instead of inferring it from rspec's exit status. The file is
# truncated before the run and read after it.
drive_counter="$repo_root/.upstream-specs/celerite-invocations.log"
: > "$drive_counter"
export CELERITE_DRIVE_COUNTER="$drive_counter"

cat > "$shim_dir/bundle" <<SHIM
#!/usr/bin/env bash
export CELERITE_BRIDGE_SERVER="$repo_root/assets/bridge/server.rb"
if [ -n "\${CELERITE_DRIVE_COUNTER:-}" ]; then
  printf '%s\n' "\$\$" >> "\$CELERITE_DRIVE_COUNTER" 2>/dev/null || true
fi
exec "$celerite_bin" "\$@"
SHIM
chmod +x "$shim_dir/bundle" 2>/dev/null || true

# Windows cmd resolution may prefer .cmd/.bat; provide both.
cat > "$shim_dir/bundle.cmd" <<SHIM
@echo off
set "CELERITE_BRIDGE_SERVER=$repo_root/assets/bridge/server.rb"
if defined CELERITE_DRIVE_COUNTER echo %RANDOM%>>"%CELERITE_DRIVE_COUNTER%"
"$celerite_bin" %*
SHIM
cat > "$shim_dir/bundle.bat" <<SHIM
@echo off
set "CELERITE_BRIDGE_SERVER=$repo_root/assets/bridge/server.rb"
if defined CELERITE_DRIVE_COUNTER echo %RANDOM%>>"%CELERITE_DRIVE_COUNTER%"
"$celerite_bin" %*
SHIM

echo "celerite binary: $celerite_bin"
echo "upstream checkout: $repo_root/.upstream-specs/$rev"
echo "real-drive counter: $drive_counter"
echo "Note: upstream lockfile specs depend on Bundler's full spec_helper/test"
echo "infrastructure (fixture repos, tmp gem env, installed bundle bins). PATH"
echo "shim targets shell-out resolution; in-example helpers may still use"
echo "upstream test-env bundle paths. Results are recorded as baseline evidence,"
echo "not a byte-green gate (see docs/upstream-spec-spike.md)."
echo

rspec_out="$repo_root/.upstream-specs/rspec-output.txt"
json_out="$repo_root/.upstream-specs/rspec-output.json"
bucket_md="$repo_root/.upstream-specs/failure-buckets.md"
mkdir -p "$(dirname "$rspec_out")"

# Truncate both rspec artifacts *before* the run (task-148). rspec only writes
# its --out files after the suite finishes; when it dies while loading
# spec_helper (LoadError, missing gem, missing `tool/`) the previous run's
# files survive on disk untouched. Reading them afterwards makes the
# real-drive self-check vouch for a run that never happened - it would report
# the *previous* example count and invocation count as this run's verdict, i.e.
# exactly the fake-green report this task exists to eliminate.
: > "$rspec_out"
: > "$json_out"

# Upstream fixture repos are built once in spec_helper's before(:suite) hook.
# build_repo1 (spec/support/builders.rb:31) copies `rake_path` -- resolved by
# path.rb:322-324 from tmp/gems/base/<engine>/<ruby>/ (base_system_gem_path is
# deliberately *not* version-scoped; only tmp(*) applies "2.1") -- into
# remote1/gems before building myrack. When upstream test deps were not
# installed (CELERITE_SKIP_TEST_DEPS=1, or a failed install_test_deps), that
# base cache is absent, rake_path is nil, and FileUtils.cp raises TypeError
# *after* build_repo has already created remote1/gems. The empty remote1 then
# short-circuits every later build_repo1 run, build_repo2 copies it verbatim,
# and lockfile specs fail with ENOENT on remote2/gems/myrack-*.gem.
#
# Repair the two poisoned preconditions from the harness side: drop a stale
# empty remote1/remote2 pair so build_repo1 runs again, and seed the scoped
# base cache with the host's rake gem when upstream's install_test_deps has
# not populated it. No vendored upstream file is modified.
tmp_root="$repo_root/.upstream-specs/$rev/bundler/tmp/2.1" # path.rb:127-136 (2.1 = "2." + scope "1")
base_gem_root="$repo_root/.upstream-specs/$rev/bundler/tmp/gems/base" # path.rb:186-188
remote1_gems="$tmp_root/gems/remote1/gems"
if [ -d "$remote1_gems" ] && [ -z "$(find "$remote1_gems" -maxdepth 1 -name '*.gem' -print -quit 2>/dev/null)" ]; then
  echo "repairing stale empty upstream fixture repo: $tmp_root/gems/remote1"
  rm -rf "$tmp_root/gems/remote1" "$tmp_root/gems/remote2"
fi
if [ -z "$(find "$base_gem_root" -name 'rake-*.gem' -print -quit 2>/dev/null)" ]; then
  scoped_path="$(ruby -rrubygems -rrbconfig -e 'print File.join(Gem.ruby_engine, RbConfig::CONFIG["ruby_version"])' 2>/dev/null || true)"
  rake_cache="$(ruby -e 'spec = Gem::Specification.find_by_name("rake") rescue nil; puts spec.cache_file if spec && File.file?(spec.cache_file)' 2>/dev/null || true)"
  if [ -z "$rake_cache" ]; then
    rake_cache="$(ruby -rrubygems -e 'puts Dir[File.join(Gem.default_dir, "cache", "rake-*.gem")].sort.last' 2>/dev/null || true)"
  fi
  if [ -n "$scoped_path" ] && [ -n "$rake_cache" ] && [ -f "$rake_cache" ]; then
    echo "seeding upstream base gem cache with $(basename "$rake_cache")"
    mkdir -p "$base_gem_root/$scoped_path/cache"
    cp "$rake_cache" "$base_gem_root/$scoped_path/cache/"
  else
    echo "warning: no rake gem available to seed upstream base cache; fixtures may be incomplete" >&2
  fi
fi


# Run from bundler dir so .rspec (--require spec_helper) and relative paths
# resolve as upstream expects. Set envs used by harness/probe workflows.
(
  cd "$repo_root/.upstream-specs/$rev/bundler"
  export PATH="$shim_dir:$PATH"
  export BUNDLE_GEMFILE=""
  export CELERITE_BRIDGE_SERVER="$repo_root/assets/bridge/server.rb"
  export CELERITE_BIN="$celerite_bin"
  # Real-drive counter (task-148): the shim appends one line per celerite launch;
  # the helper override appends one line per in-example drive.
  export CELERITE_DRIVE_COUNTER="$drive_counter"
  # Optional: skip upstream install_test_deps (avoids network/dev bundle setup,
  # but may leave fixture/base gems unbuilt). Off by default.
  if [ "${CELERITE_SKIP_TEST_DEPS:-}" = "1" ]; then
    export RSPEC_FORMATTER_OUTPUT_ID="celerite-harness"
  fi
  # Prefer `ruby -S rspec` for Windows/Git Bash portability.
  # Real-drive is the default (see header Notes). =0 restores the baseline.
  rspec_pre_args=()
  if [ "${CELERITE_BUNDLE_HELPER_OVERRIDE:-1}" != "0" ]; then
    rspec_pre_args=(-r "$repo_root/script/upstream-specs-celerite-override.rb")
  fi
  if command -v ruby >/dev/null 2>&1; then
    ruby -S rspec "${rspec_pre_args[@]}" spec/lock/lockfile_spec.rb --format documentation --out "$rspec_out" --format json --out "$json_out" 2>&1
  else
    rspec "${rspec_pre_args[@]}" spec/lock/lockfile_spec.rb --format documentation --out "$rspec_out" --format json --out "$json_out" 2>&1
  fi
)
rspec_status=$?
tail -20 "$rspec_out" 2>/dev/null || true

summary="$(grep -E '^[0-9]+ examples' "$rspec_out" 2>/dev/null | tail -1 || true)"
if [ -z "$summary" ] && [ $rspec_status -ne 0 ]; then
  summary="rspec exited $rspec_status (no example summary captured)"
fi

# --- real-drive self-check (task-148) ---------------------------------------
# Two independent measures, because each alone can lie:
#   1. counter file  - written by the shim / helper override on every launch
#   2. output scan   - "celerite"/"celerite.exe" appearing in an invocation line
# The counter is authoritative when present (it cannot be produced by an
# unrelated log line), and the output scan is the fallback for callers that run
# with an externally provided counter.
drive_counter_count=0
if [ -f "$drive_counter" ]; then
  drive_counter_count="$(grep -c . "$drive_counter" 2>/dev/null || true)"
  drive_counter_count="${drive_counter_count:-0}"
fi
celerite_invocations="$(grep -c -E 'celerite(\.exe)? ' "$rspec_out" 2>/dev/null || true)"
celerite_invocations="${celerite_invocations:-0}"
if [ "$drive_counter_count" -gt "$celerite_invocations" ]; then
  celerite_invocations="$drive_counter_count"
fi

# Parse the example counts so "0 examples" is a first-class failure rather than
# a harmless-looking summary line.
examples_total="$(printf '%s' "$summary" | sed -n 's/^\([0-9][0-9]*\) example.*/\1/p' | head -1)"
examples_total="${examples_total:-0}"
failures_total="$(printf '%s' "$summary" | sed -n 's/^[0-9][0-9]* examples*, \([0-9][0-9]*\) failure.*/\1/p' | head -1)"
failures_total="${failures_total:-0}"

# Classify failures from the rspec JSON formatter into environment, fixture and
# product buckets (bash 3.2 compatible; parsing is done by ruby, which the
# harness already requires).
ruby -rjson -r "$repo_root/script/upstream-specs-buckets.rb" -e '
  json_path, out_path = ARGV
  data = JSON.parse(File.read(json_path)) rescue { "examples" => [] }
  failures = (data["examples"] || []).select { |example| example["status"] == "failed" }
  buckets = Hash.new { |hash, key| hash[key] = [] }
  failures.each do |example|
    exception = example["exception"] || {}
    klass = exception["class"].to_s
    message = exception["message"].to_s
    backtrace = (exception["backtrace"] || []).join("\n")
    text = klass + "\n" + message + "\n" + backtrace
    # Rule table lives in `script/upstream-specs-buckets.rb` so the offline
    # re-bucket tool applies exactly the same classification (task-91).
    bucket = UpstreamSpecsBuckets.classify(klass, message, backtrace)
    first_line = message.lines.first.to_s.strip
    first_line = klass if first_line.empty?
    buckets[bucket] << [example["full_description"].to_s, first_line]
  end
  order = UpstreamSpecsBuckets::ORDER
  lines = ["## Failure buckets", ""]
  order.each do |bucket|
    items = buckets[bucket]
    next if items.empty?
    lines << "### #{bucket} (#{items.size})"
    lines << ""
    items.each { |description, first_line| lines << "- `#{description}` :: #{first_line}" }
    lines << ""
  end
  (buckets.keys - order).each do |bucket|
    lines << "### #{bucket} (#{buckets[bucket].size})"
    lines << ""
    buckets[bucket].each { |description, first_line| lines << "- `#{description}` :: #{first_line}" }
    lines << ""
  end
  File.write(out_path, lines.join("\n")) unless out_path.nil?
' "$json_out" "$bucket_md"

# --- harness verdict (task-148) ---------------------------------------------
# Decide what this run actually proved BEFORE writing the report, so the report
# and the exit code agree and neither can claim success the counters deny.
harness_rc=$rspec_status
verdict="ok (rspec exit $rspec_status)"
if [ "$examples_total" -eq 0 ]; then
  # rspec loaded no examples: the suite never ran. This is the exact shape a
  # broken checkout or a missing PATH dependency produces, and it used to be
  # reported as a tidy "0 examples, 0 failures" body with exit 1 that happened
  # to be non-zero only because rspec counted the load error itself.
  verdict="the upstream suite ran 0 examples (environment/checkout unusable)"
  harness_rc=$exit_env_unusable
elif [ "$celerite_invocations" -eq 0 ]; then
  # Examples ran but nothing invoked celerite: the shim/override wiring broke,
  # so the failures below are NOT evidence about celerite.
  verdict="the upstream suite did not drive celerite (0 invocations)"
  harness_rc=$exit_not_driving
fi

{
  echo "# Upstream lockfile spec results - $rev"
  echo
  echo "Generated by \`script/upstream-specs\` on $(date -u +%Y-%m-%d)."
  echo
  echo "## Harness"
  echo
  echo "- Upstream: \`rubygems/rubygems@$rev\`, spec \`bundler/spec/lock/lockfile_spec.rb\`"
  echo "- Runner: \`rspec --format documentation\` from \`.upstream-specs/$rev/bundler\`"
  echo "- Celerite binary: \`$celerite_bin\`"
  echo "- Shim: \`.upstream-specs/shim/bundle\` (+ .bat/.cmd) exporting \`CELERITE_BRIDGE_SERVER\` and exec'ing celerite"
  echo "- Sparse checkout: \`bundler/spec bundler/lib bundler/bin bundler/exe\`"
  echo "- Checkout HEAD: \`$checkout_rev\` (integrity pre-check passed)"
  echo "- Raw output: \`.upstream-specs/rspec-output.txt\` (gitignored, local evidence)"
  echo "- rspec exit status: $rspec_status"
  echo "- real-drive counter file: \`$drive_counter\` ($drive_counter_count lines)"
  echo
  echo "## Result summary"
  echo
  echo "${summary:-(no summary line found)}"
  echo
  echo "- real-drive: $celerite_invocations celerite invocations"
  if [ "$celerite_invocations" -eq 0 ]; then
    echo "- WARNING: NOT driving celerite (helper override disabled or not applied)"
  fi
  echo "- harness verdict: $verdict"
  echo
  cat "$bucket_md" 2>/dev/null || { echo "## Failure buckets"; echo; echo "(no failure data)"; }
  echo
  echo "## Output tail"
  echo
  echo "\`\`\`"
  tail -60 "$rspec_out" 2>/dev/null || echo "(no output)"
  echo "\`\`\`"
  echo
  echo "## Interpretation"
  echo
  echo "See \`docs/upstream-spec-spike.md\` for harness-precondition analysis,"
  echo "per-failure classification (harness/precondition/unexecuted vs real"
  echo "compatibility gap), and applicability notes. This run is baseline"
  echo "evidence, not a byte-green compatibility gate."
} > "$report"

echo "wrote $report"
case "$verdict" in
  ok*)
    ;;
  *)
    echo "error: $verdict" >&2
    echo "       harness exit $harness_rc (rspec exited $rspec_status)" >&2
    echo "       report: $report" >&2
    ;;
esac
exit "$harness_rc"