#!/usr/bin/env bash
# Differential test harness (M0): runs the same fixture through the pinned
# reference Bundler and Celerite in isolated sandboxes, then compares exit
# codes, stdout, stderr and the resulting project file tree after normalizing
# sandbox paths.
#
# Usage:
#   script/differential                # all fixtures, bundler 4.0.24
#   script/differential <fixture>...   # selected fixtures
#   BUNDLER_REF_VERSION=2.7.2 script/differential
#
# Reference Bundler versions must be installed with `gem install bundler -v <v>`
# (see vendor/reference/MANIFEST.md). The harness requires no network: fixtures
# are lockfile-driven and every command runs with empty isolated gem homes.
set -uo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
bundler_version="${BUNDLER_REF_VERSION:-4.0.24}"
celerite_bin="$repo_root/bin/celerite"
fixtures_root="$repo_root/fixtures/differential"
selected=("$@")

if [ ! -x "$celerite_bin" ]; then
  (cd "$repo_root" && shards build >/dev/null) || { echo "celerite build failed" >&2; exit 2; }
fi

bundler_exe="$(ruby -e 'begin
  spec = Gem::Specification.find_by_name("bundler", ARGV[0])
  puts File.join(spec.full_gem_path, "exe", "bundle")
rescue Gem::LoadError
  abort "bundler #{ARGV[0]} is not installed; see vendor/reference/MANIFEST.md"
end' "$bundler_version")" || exit 2

normalize() {
  # $1 = reference sandbox, $2 = celerite sandbox
  sed -e "s|$1|{SANDBOX}|g" \
      -e "s|$2|{SANDBOX}|g" \
      -e 's/\r$//' \
      -e 's/[0-9][0-9-]*T[0-9:.+-]*Z/{TIMESTAMP}/g' \
      -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}/{DATE}/g'
}

pass=0
fail=0
skipped=0

run_fixture() {
  local fixture_dir="$1"
  local name
  name="$(basename "$fixture_dir")"
  local command_line
  command_line="$(cat "$fixture_dir/command")"

  local work
  work="$(mktemp -d)"
  local ref_sandbox="$work/reference"
  local cel_sandbox="$work/celerite"
  mkdir -p "$ref_sandbox/project" "$ref_sandbox/home" "$ref_sandbox/gems" "$ref_sandbox/bundle"
  mkdir -p "$cel_sandbox/project" "$cel_sandbox/home" "$cel_sandbox/gems" "$cel_sandbox/bundle"

  cp "$fixture_dir"/Gemfile "$ref_sandbox/project/" 2>/dev/null
  cp "$fixture_dir"/Gemfile.lock "$ref_sandbox/project/" 2>/dev/null
  cp "$fixture_dir"/Gemfile "$cel_sandbox/project/" 2>/dev/null
  cp "$fixture_dir"/Gemfile.lock "$cel_sandbox/project/" 2>/dev/null
  # extra files, if any
  if compgen -G "$fixture_dir/extra/*" > /dev/null; then
    cp -r "$fixture_dir/extra/." "$ref_sandbox/project/"
    cp -r "$fixture_dir/extra/." "$cel_sandbox/project/"
  fi

  local isolated_env=(
    HOME="$ref_sandbox/home" USERPROFILE="$ref_sandbox/home"
    GEM_HOME="$ref_sandbox/gems" GEM_PATH="$ref_sandbox/gems"
    BUNDLE_PATH="$ref_sandbox/bundle" RUBYOPT=""
  )

  # reference run (inside the sandbox project directory)
  (
    cd "$ref_sandbox/project" || exit 99
    env "${isolated_env[@]}" ruby "$bundler_exe" $command_line
  ) > "$work/ref.out" 2> "$work/ref.err"
  local ref_code=$?

  # celerite run
  (
    cd "$cel_sandbox/project" || exit 99
    env HOME="$cel_sandbox/home" USERPROFILE="$cel_sandbox/home" \
      GEM_HOME="$cel_sandbox/gems" GEM_PATH="$cel_sandbox/gems" \
      BUNDLE_PATH="$cel_sandbox/bundle" RUBYOPT="" \
      "$celerite_bin" $command_line
  ) > "$work/cel.out" 2> "$work/cel.err"
  local cel_code=$?

  normalize "$ref_sandbox" "$cel_sandbox" < "$work/ref.out" > "$work/ref.out.n"
  normalize "$ref_sandbox" "$cel_sandbox" < "$work/cel.out" > "$work/cel.out.n"
  normalize "$ref_sandbox" "$cel_sandbox" < "$work/ref.err" > "$work/ref.err.n"
  normalize "$ref_sandbox" "$cel_sandbox" < "$work/cel.err" > "$work/cel.err.n"

  local ok=1
  local detail=""
  if [ "$ref_code" != "$cel_code" ]; then
    ok=0; detail+="  exit code: reference=$ref_code celerite=$cel_code"$'\n'
  fi
  if ! diff -q "$work/ref.out.n" "$work/cel.out.n" >/dev/null; then
    ok=0; detail+="  stdout differs:"$'\n'"$(diff "$work/ref.out.n" "$work/cel.out.n" | head -15)"$'\n'
  fi
  if ! diff -q "$work/ref.err.n" "$work/cel.err.n" >/dev/null; then
    ok=0; detail+="  stderr differs:"$'\n'"$(diff "$work/ref.err.n" "$work/cel.err.n" | head -15)"$'\n'
  fi
  if ! diff -rq "$ref_sandbox/project" "$cel_sandbox/project" >/dev/null 2>&1; then
    ok=0; detail+="  project tree differs:"$'\n'"$(diff -rq "$ref_sandbox/project" "$cel_sandbox/project" | head -10)"$'\n'
  fi

  if [ "$ok" = 1 ]; then
    echo "PASS $name (exit=$ref_code)"
    pass=$((pass + 1))
  else
    echo "FAIL $name ($command_line)"
    echo "$detail" | sed 's/^/    /'
    fail=$((fail + 1))
  fi
  rm -rf "$work"
}

fixtures=()
if [ ${#selected[@]} -gt 0 ]; then
  for name in "${selected[@]}"; do
    fixtures+=("$fixtures_root/$name")
  done
else
  for dir in "$fixtures_root"/*/; do
    fixtures+=("${dir%/}")
  done
fi

for fixture in "${fixtures[@]}"; do
  [ -f "$fixture/command" ] || continue
  if [ -f "$fixture/deferred-$bundler_version" ]; then
    echo "SKIP $(basename "$fixture") (deferred for $bundler_version: $(head -1 "$fixture/deferred-$bundler_version"))"
    skipped=$((skipped + 1))
    continue
  fi
  run_fixture "$fixture"
done

echo
echo "differential ($bundler_version): $pass passed, $fail failed, $skipped skipped (documented deferrals)"
[ "$fail" -eq 0 ]
