#!/usr/bin/env bash
# Differential test harness (M0): runs the same fixture through the pinned
# reference Bundler and Celerite in isolated sandboxes, then compares exit
# codes, stdout, stderr and the resulting project file tree after normalizing
# sandbox paths.
#
# Usage:
#   script/differential                # all fixtures, bundler 4.0.24
#   script/differential <fixture>...   # selected fixtures
#   BUNDLER_REF_VERSION=2.7.2 script/differential
#
# Reference Bundler versions must be installed with `gem install bundler -v <v>`
# (see vendor/reference/MANIFEST.md). The harness requires no network: fixtures
# are lockfile-driven and every command runs with empty isolated gem homes.
# Normalization rules applied to both sides (complete list; see
# docs/differential-normalization.md):
#   N1 sandbox paths (native + MSYS spelling) -> {SANDBOX}
#   N2 CRLF -> LF
#   N3 ISO timestamps -> {TIMESTAMP}
#   N4 calendar dates -> {DATE}
#   N5 `## Environment` body (until `## Bundle Doctor`) dropped
#   N6 Ruby backtrace `   from ...` frames dropped
#   N7 runs of consecutive `Fetching ` lines sorted (parallel download order)
#   N8 native-extension fixtures require a C compiler on PATH (Ruby-bundled
#      gcc at C:\Ruby40-x64\msys64\ucrt64\bin on this host); the harness
#      prepends the Ruby-bundled toolchain dir so reference and celerite
#      builds use the same compiler revision.  Set CELERITE_DIFF_EXTRA_PATH
#      to prepend additional directories to PATH for both sides.
#   N9 installed-tree binary artifacts (.so/.dll/.bundle/.o/.a) compare by
#      presence + non-empty size + optional ruby loadability, never bytes:
#      native builds are non-deterministic; the observable contract is
#      "compiled and loadable", not byte-identical output.
# Note (build PATH): build the CLI with the ORIGINAL PATH (Git/msys64/Ruby
#   order), NOT the N8-normalized PATH: prepending the Ruby-bundled toolchain
#   makes `cc` fail with "liblto_plugin.dll not found" (toolchain resolution,
#   not a product defect).  The N8 normalization applies to fixture runs only.
# Note (2026-11-14 N): earlier "make not found" failures for class A
#   (racc/make) fixtures were an ENVIRONMENT issue, not a missing tool:
#   make.exe exists at C:\Ruby40-x64\msys64\usr\bin\make.exe (GNU 4.4.1)
#   but was not on PATH.  The PATH normalization below resolves this.
# Exit codes, all other line ordering, trees and file contents must match.
set -uo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
bundler_version="${BUNDLER_REF_VERSION:-4.0.24}"
# CELERITE_BIN overrides the engine under test (e.g. a gem-installed shim:
# CELERITE_BIN="$gem_home/bin/celerite" script/differential <fixture>).
# When CELERITE_BIN is explicitly provided, require the file to exist and
# skip `shards build` (caller supplies the engine binary); default path
# still auto-builds when missing/non-executable.
celerite_bin_default="$repo_root/bin/celerite"
celerite_bin="${CELERITE_BIN:-$celerite_bin_default}"
fixtures_root="$repo_root/fixtures/differential"
selected=("$@")

# Normalize PATH so reference Bundler and celerite use the same C compiler
# revision for native-extension builds.  On Windows the Ruby-bundled toolchain
# (C:\Ruby40-x64\msys64\ucrt64\bin) must precede the standalone MSYS2
# toolchain (C:\msys64\ucrt64\bin) which ships a different GCC revision.
# CELERITE_DIFF_EXTRA_PATH (colon-separated) is prepended first, allowing
# callers to inject additional tool directories.
if [ -n "${CELERITE_DIFF_EXTRA_PATH:-}" ]; then
  PATH="$CELERITE_DIFF_EXTRA_PATH:$PATH"
fi
# Prefer Ruby-bundled toolchain when present (same revision as reference).
# The usr/bin directory supplies msys `make`/`sed`; it is required for native
# extension builds even though its Cygwin shared-memory namespace is distinct.
for _d in /c/Ruby40-x64/msys64/ucrt64/bin /c/Ruby40-x64/msys64/usr/bin; do
  [ -d "$_d" ] && PATH="$_d:$PATH"
done
export PATH

if [ -n "${CELERITE_BIN:-}" ]; then
  if [ ! -f "$celerite_bin" ]; then
    echo "CELERITE_BIN not found: $celerite_bin" >&2
    exit 2
  fi
elif [ ! -x "$celerite_bin" ]; then
  (cd "$repo_root" && shards build >/dev/null) || { echo "celerite build failed" >&2; exit 2; }
fi

bundler_paths="$(ruby -e 'begin
  spec = Gem::Specification.find_by_name("bundler", ARGV[0])
  puts File.join(spec.full_gem_path, "exe", "bundle")
  puts File.join(spec.full_gem_path, "lib")
rescue Gem::LoadError
  abort "bundler #{ARGV[0]} is not installed; see vendor/reference/MANIFEST.md"
end' "$bundler_version")" || exit 2
bundler_exe="$(echo "$bundler_paths" | head -1)"
bundler_lib="$(echo "$bundler_paths" | tail -1)"

# Optional installed-tree comparison helper (see docs/differential-normalization.md).
. "$repo_root/script/differential-installed-tree"

normalize() {
  # $1 = reference sandbox, $2 = celerite sandbox
  # Program output uses Windows paths; the sandbox vars are MSYS paths, so
  # normalize both spellings.
  local ref_win="$(cygpath -m "$1" 2>/dev/null || echo "$1")"
  local cel_win="$(cygpath -m "$2" 2>/dev/null || echo "$2")"
  sed -e "s|$1|{SANDBOX}|g" \
      -e "s|$2|{SANDBOX}|g" \
      -e "s|$ref_win|{SANDBOX}|g" \
      -e "s|$cel_win|{SANDBOX}|g" \
      -e 's/\r$//' \
      -e 's/[0-9][0-9-]*T[0-9:.+-]*Z/{TIMESTAMP}/g' \
      -e 's/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/{DATE}/g' \
      -e 's/^Git SHA[[:space:]].*/Git SHA    {GIT_SHA}/' \
      -e 's/^bundle #!.*/bundle #!  {BUNDLE_SHEBANG}/' \
      -e '/^[ 	]*from /d' \
    | awk '
        # N5 drops the `## Environment` body only for `bundle doctor` reports,
        # which terminate it with `## Bundle Doctor`. A standalone `bundle env`
        # output has no terminator, and the old sed range
        # (`/^## Environment$/,/^## Bundle Doctor$/...`) therefore deleted the
        # whole section down to EOF on both sides: env-report compared empty
        # strings and always passed. Buffer the section and drop it only when
        # the terminator is present.
        /^## Environment$/ { in_env = 1; env_count = 0; env_buf[env_count++] = $0; next }
        in_env && /^## Bundle Doctor$/ { in_env = 0; env_count = 0; print; next }
        in_env { env_buf[env_count++] = $0; next }
        { print }
        END { if (in_env) for (i = 0; i < env_count; i++) print env_buf[i] }
      ' \
    | awk '
        /^Fetching / { buf[n++] = $0; next }
        {
          if (n > 0) {
            for (i = 1; i < n; i++) {
              v = buf[i]
              for (j = i - 1; j >= 0 && buf[j] > v; j--) buf[j+1] = buf[j]
              buf[j+1] = v
            }
            for (i = 0; i < n; i++) print buf[i]
            n = 0
          }
          print
        }
        END {
          for (i = 1; i < n; i++) {
            v = buf[i]
            for (j = i - 1; j >= 0 && buf[j] > v; j--) buf[j+1] = buf[j]
            buf[j+1] = v
          }
          for (i = 0; i < n; i++) print buf[i]
        }
      '
}

pass=0
fail=0
skipped=0

run_fixture() {
  local fixture_dir="$1"
  local name
  name="$(basename "$fixture_dir")"
  # Multiple lines = multiple sequential runs (e.g. install reruns)
  command_line="$(cat "$fixture_dir/command")"

  local work
  # Sandboxes default to the repository checkout because on Windows hosts with a
  # workspace-write file policy the celerite binary may only write under the
  # workspace.  The Ruby-bundled MSYS2 toolchain prepended to PATH also has a
  # different `/tmp` mount than the caller's Git-bash, so relying on `/tmp`
  # mixes directories (mkdir lands in one root, redirections in another).
  # CELERITE_DIFF_WORK_ROOT still overrides the location.
  # The sandbox path must stay short enough that absolute paths in bundled
  # output are not column-wrapped: a wrapped path cannot be replaced by the
  # {SANDBOX} normalisation and shows up as a false difference. The repo lives
  # inside the workspace because celerite can only write inside it here.
  local work_root="${CELERITE_DIFF_WORK_ROOT:-$repo_root/.d}"
  mkdir -p "$work_root"
  work="$(mktemp -d "$work_root/XXXXXX")"
  # Both sandbox directory names must have the same length: reference output
  # wraps long paths at a fixed column, so a one-character difference would
  # move the wrap point and make normalization compare different fragments.
  local ref_sandbox="$work/ref"
  local cel_sandbox="$work/cel"
  mkdir -p "$ref_sandbox/project" "$ref_sandbox/home" "$ref_sandbox/gems" "$ref_sandbox/bundle"
  mkdir -p "$cel_sandbox/project" "$cel_sandbox/home" "$cel_sandbox/gems" "$cel_sandbox/bundle"
  # Isolated temp root: MSYS2 `make` creates its shared-memory backing files
  # under TMP; when celerite runs under a workspace-write file policy, a TMP
  # outside the workspace is denied (NtCreateDirectoryObject 0xC0000022) and
  # native extension builds fail. Both sides therefore share this sandbox tmp.
  mkdir -p "$work/tmp"
  work_tmp_win="$(cygpath -w "$work/tmp" 2>/dev/null || echo "$work/tmp")"

  # Ruby (native Windows) needs a Windows path for file:// sources
  index_dir="$(cygpath -m "$repo_root/fixtures/gem-index" 2>/dev/null || echo "$repo_root/fixtures/gem-index")"
  scoped_index_dir="$(cygpath -m "$repo_root/fixtures/gem-index-scoped" 2>/dev/null || echo "$repo_root/fixtures/gem-index-scoped")"
  locked_deps_index_dir="$(cygpath -m "$repo_root/fixtures/gem-index-locked-deps" 2>/dev/null || echo "$repo_root/fixtures/gem-index-locked-deps")"
  platform_index_dir="$(cygpath -m "$repo_root/fixtures/gem-index-platform" 2>/dev/null || echo "$repo_root/fixtures/gem-index-platform")"
plugin_index_dir="$(cygpath -m "$repo_root/fixtures/gem-index-plugin" 2>/dev/null || echo "$repo_root/fixtures/gem-index-plugin")"
# Remote compact-index metadata constraints (ruby/rubygems fields in /info).
ruby_constraints_index_dir="$(cygpath -m "$repo_root/fixtures/gem-index-ruby-constraints" 2>/dev/null || echo "$repo_root/fixtures/gem-index-ruby-constraints")"
  locked_ruby_index_dir="$(cygpath -m "$repo_root/fixtures/gem-index-locked-ruby" 2>/dev/null || echo "$repo_root/fixtures/gem-index-locked-ruby")"
  plugin_source_index_dir="$(cygpath -m "$repo_root/fixtures/gem-index-plugin-source" 2>/dev/null || echo "$repo_root/fixtures/gem-index-plugin-source")"
  plugin_gem_index_dir="$(cygpath -m "$repo_root/fixtures/gem-index-plugin-gem" 2>/dev/null || echo "$repo_root/fixtures/gem-index-plugin-gem")"
  legacy_index_dir="$(cygpath -m "$repo_root/fixtures/gem-index-legacy" 2>/dev/null || echo "$repo_root/fixtures/gem-index-legacy")"
  ruby_versions_index_dir="$(cygpath -m "$repo_root/fixtures/gem-index-ruby-versions" 2>/dev/null || echo "$repo_root/fixtures/gem-index-ruby-versions")"
  index_url="file://$index_dir"
  # Copy Gemfile/Gemfile.lock with placeholder substitution but keep the
  # fixture's line-ending style: sed re-emits lines with plain LF, so when the
  # source file contains CR we rewrite the result with a bash line loop that
  # strips any existing CR and writes CRLF (the `file-crlf` marker checks this).
  copy_fixture_text() {
    local src="$1" dst="$2" tmp
    tmp="$(dirname "$dst")/.celerite-copy.$$"
    sed -e "s|@INDEX_DIR@|$index_dir|" -e "s|@SCOPED_INDEX_DIR@|$scoped_index_dir|" -e "s|@LOCKED_DEPS_INDEX_DIR@|$locked_deps_index_dir|" -e "s|@RUBY_CONSTRAINTS_INDEX_DIR@|$ruby_constraints_index_dir|" -e "s|@PLATFORM_INDEX_DIR@|$platform_index_dir|" -e "s|@PLUGIN_INDEX_DIR@|$plugin_index_dir|" -e "s|@LOCKED_RUBY_INDEX_DIR@|$locked_ruby_index_dir|" -e "s|@PLUGIN_SOURCE_INDEX_DIR@|$plugin_source_index_dir|" -e "s|@PLUGIN_GEM_INDEX_DIR@|$plugin_gem_index_dir|" -e "s|@LEGACY_INDEX_DIR@|$legacy_index_dir|" -e "s|@RUBY_VERSIONS_INDEX_DIR@|$ruby_versions_index_dir|" -e "s|@BUNDLER_VERSION@|$bundler_version|" "$src" > "$tmp"
    # MSYS grep auto-strips CRLF before matching, so `grep -q $'\r'` cannot
    # see it; inspect the hex dump instead (0d0a = CRLF byte pair).
    if od -An -tx1 "$src" | tr -d ' \n' | grep -q '0d0a'; then
      while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        printf '%s\r\n' "$line"
      done < "$tmp" > "$dst"
      rm -f "$tmp"
    else
      mv "$tmp" "$dst"
    fi
  }
  for side in ref cel; do
    sandbox="$ref_sandbox"; [ "$side" = "cel" ] && sandbox="$cel_sandbox"
    for f in Gemfile Gemfile.lock; do
      [ -f "$fixture_dir/$f" ] || continue
      copy_fixture_text "$fixture_dir/$f" "$sandbox/project/$f"
    done
  done
  # extra files, if any (including dotfiles such as .bundle/config: `*` glob
  # would miss them, so gate on directory existence instead)
  if [ -d "$fixture_dir/extra" ]; then
    cp -r "$fixture_dir/extra/." "$ref_sandbox/project/"
    cp -r "$fixture_dir/extra/." "$cel_sandbox/project/"
    # substitute placeholders in extra text files (scripts, configs)
    for side in ref cel; do
      sandbox="$ref_sandbox"; [ "$side" = "cel" ] && sandbox="$cel_sandbox"
      while IFS= read -r ef; do
        sed -i -e "s|@INDEX_DIR@|$index_dir|g" -e "s|@SCOPED_INDEX_DIR@|$scoped_index_dir|g" -e "s|@LOCKED_DEPS_INDEX_DIR@|$locked_deps_index_dir|g" -e "s|@RUBY_CONSTRAINTS_INDEX_DIR@|$ruby_constraints_index_dir|g" -e "s|@PLATFORM_INDEX_DIR@|$platform_index_dir|g" -e "s|@PLUGIN_INDEX_DIR@|$plugin_index_dir|g" -e "s|@LOCKED_RUBY_INDEX_DIR@|$locked_ruby_index_dir|g" -e "s|@PLUGIN_SOURCE_INDEX_DIR@|$plugin_source_index_dir|g" -e "s|@PLUGIN_GEM_INDEX_DIR@|$plugin_gem_index_dir|g" -e "s|@LEGACY_INDEX_DIR@|$legacy_index_dir|g" -e "s|@RUBY_VERSIONS_INDEX_DIR@|$ruby_versions_index_dir|g" -e "s|@BUNDLER_VERSION@|$bundler_version|g" "$ef"
      done < <(find "$sandbox/project" -type f \( -name "*.rb" -o -name "*.txt" -o -name "*.gemfile" \) 2>/dev/null)
    done
  fi

  # Bundle-path preset, if any: some fixtures need gems that are already
  # "installed" (e.g. `check` with satisfied dependencies). Each side gets its
  # own BUNDLE_PATH (see the run block below), so seed both from the same
  # fixture directory; the tree is sandbox-internal and never compared.
  if [ -d "$fixture_dir/bundle-preset" ]; then
    cp -r "$fixture_dir/bundle-preset/." "$ref_sandbox/bundle/"
    cp -r "$fixture_dir/bundle-preset/." "$cel_sandbox/bundle/"
  fi

  # Git-source fixtures: nested .git directories cannot be committed, so each
  # directory listed in the fixture's `git-init` manifest is materialized here
  # as a real repo. One staging init per side keeps both runs on the same
  # commit SHA (deterministic author/committer env pins the SHA).
  #
  # The staging dir lives inside $work and `git -C` receives a Windows path
  # (`cygpath -w`). With the earlier form (`staging="$(mktemp -d)"`, POSIX path
  # straight into `git -C`) the copied `project/<rel>` had no `.git` and the
  # reference failed with `repository './gitgem' does not exist`; reverting
  # these two lines reproduces that failure, so the conversion is load-bearing.
  # The exact path-root mismatch was not reproduced in isolation (a standalone
  # replay of the old commands produced a valid `.git`), so the mechanism stays
  # a hypothesis while the fix itself is verified.
  if [ -f "$fixture_dir/git-init" ]; then
    staging="$(mktemp -d "$work/gitstage.XXXXXX")"
    staging_win="$(cygpath -w "$staging")"
    while IFS= read -r rel; do
      [ -d "$fixture_dir/extra/$rel" ] || continue
      rm -rf "$staging/$rel"
      mkdir -p "$staging/$rel"
      cp -r "$fixture_dir/extra/$rel/." "$staging/$rel/"
      rm -rf "$staging/$rel/.git"
      GIT_AUTHOR_NAME=fixture GIT_AUTHOR_EMAIL=fixture@example.test \
      GIT_COMMITTER_NAME=fixture GIT_COMMITTER_EMAIL=fixture@example.test \
      GIT_AUTHOR_DATE="2026-01-01T00:00:00Z" GIT_COMMITTER_DATE="2026-01-01T00:00:00Z" \
        git -C "$staging_win/$rel" -c core.autocrlf=false -c commit.gpgsign=false \
        init -q -b master >/dev/null
      git -C "$staging_win/$rel" -c core.autocrlf=false add -A
      GIT_AUTHOR_NAME=fixture GIT_AUTHOR_EMAIL=fixture@example.test \
      GIT_COMMITTER_NAME=fixture GIT_COMMITTER_EMAIL=fixture@example.test \
      GIT_AUTHOR_DATE="2026-01-01T00:00:00Z" GIT_COMMITTER_DATE="2026-01-01T00:00:00Z" \
        git -C "$staging_win/$rel" -c commit.gpgsign=false commit -q -m init
      # Tags cannot be committed into the tree, so fixtures list them in an
      # optional `git-tag` TSV manifest (`<rel>\t<tag>`); tag the staged repo
      # here, before it is copied into both sandboxes.
      if [ -f "$fixture_dir/git-tag" ]; then
        while IFS=$'\t' read -r tag_rel tag_name; do
          [ "$tag_rel" = "$rel" ] || continue
          [ -n "$tag_name" ] || continue
          git -C "$staging_win/$rel" -c commit.gpgsign=false tag "$tag_name"
        done < "$fixture_dir/git-tag"
      fi
      for side in ref cel; do
        sandbox="$ref_sandbox"; [ "$side" = "cel" ] && sandbox="$cel_sandbox"
        rm -rf "$sandbox/project/$rel"
        cp -r "$staging/$rel" "$sandbox/project/$rel"
      done
    done < "$fixture_dir/git-init"
    rm -rf "$staging"
  fi

  local isolated_env=(
    HOME="$ref_sandbox/home" USERPROFILE="$ref_sandbox/home"
    GEM_HOME="$ref_sandbox/gems" GEM_PATH="$ref_sandbox/gems"
    BUNDLE_PATH="$ref_sandbox/bundle" RUBYOPT=""
    TMP="$work_tmp_win" TEMP="$work_tmp_win" TMPDIR="$work/tmp"
  )

  # Fixtures with a `frozen` marker run both sides under BUNDLE_FROZEN=true so
  # the frozen-mode guards (e.g. ruby unlocking) are exercised by the oracle.
  frozen_env=""
  if [ -f "$fixture_dir/frozen" ]; then
    frozen_env="BUNDLE_FROZEN=true"
    isolated_env+=(BUNDLE_FROZEN=true)
  fi
  # `deploy` exercises deployment mode: same guard, but the "remove the freeze"
  # hint is kept (definition.rb:475-492 only drops it for the :env source).
  deploy_env=""
  if [ -f "$fixture_dir/deploy" ]; then
    deploy_env="BUNDLE_DEPLOYMENT=true"
    isolated_env+=(BUNDLE_DEPLOYMENT=true)
  fi

  # HTTP-index fixtures (http-index marker): serve a v2 compact-index HTTP root
  # so cooldown/ETag behavior matches rubygems.org semantics that file://
  # marshal indexes never exercise. An empty marker serves fixtures/gem-index;
  # a non-empty first line names another index directory (relative to the repo).
  http_server_pid=""
  if [ -f "$fixture_dir/http-index" ]; then
    http_index_relative="$(head -n 1 "$fixture_dir/http-index" 2>/dev/null | tr -d '\r')"
    if [ -n "$http_index_relative" ]; then
      http_index_dir="$repo_root/$http_index_relative"
    else
      http_index_dir="$repo_root/fixtures/gem-index"
    fi
    # Refuse to reuse a foreign listener: a stale server from an earlier run
    # would silently serve the wrong index and mask harness regressions.
    if curl -sf -o /dev/null --max-time 1 "http://127.0.0.1:8765/versions" 2>/dev/null; then
      echo "SKIP $(basename "$fixture_dir") (http-index port 127.0.0.1:8765 already in use; refusing to reuse a foreign server)" >&2
      skipped=$((skipped + 1))
      return 0
    fi
    node "$repo_root/script/http_index_server.js" "$http_index_dir" 8765 >/dev/null 2>&1 &
    http_server_pid=$!
    # Bounded readiness wait (~10s, 100ms poll). Without this the first command
    # races the server's listen() and fails with ECONNREFUSED.
    http_ready=0
    for _ in $(seq 1 100); do
      if curl -sf -o /dev/null --max-time 1 "http://127.0.0.1:8765/versions" 2>/dev/null; then
        http_ready=1
        break
      fi
      sleep 0.1
    done
    if [ "$http_ready" -ne 1 ]; then
      echo "SKIP $(basename "$fixture_dir") (http-index server did not answer http://127.0.0.1:8765/versions within 10s)" >&2
      kill "$http_server_pid" 2>/dev/null || true
      wait "$http_server_pid" 2>/dev/null || true
      http_server_pid=""
      skipped=$((skipped + 1))
      return 0
    fi
  fi

  # Reference run(s): one per command line (multi-line command files run the
  # commands in sequence), outputs concatenated, last exit code kept. Loops
  # use dedicated fds so the sandboxed commands cannot eat the command list.
  #
  # Each command writes its own file and the files are concatenated afterwards.
  # Re-opening a shared `ref.out` with `>>` in this MSYS bash hands the child an
  # fd that starts at offset 0, so the second command overwrote the beginning of
  # the first command's output (seen as truncated/duplicated lines in
  # `install-check`/`cache`). Per-command files make the capture append-only.
  : > "$work/ref.out"; : > "$work/ref.err"; ref_code=0; ref_n=0
  while IFS= read -r cmd <&3; do
    [ -z "$cmd" ] && continue
    cmd="$(printf '%s' "$cmd" | sed -e "s|@INDEX_DIR@|$index_dir|g" -e "s|@SCOPED_INDEX_DIR@|$scoped_index_dir|g" -e "s|@LOCKED_DEPS_INDEX_DIR@|$locked_deps_index_dir|g" -e "s|@RUBY_CONSTRAINTS_INDEX_DIR@|$ruby_constraints_index_dir|g" -e "s|@PLATFORM_INDEX_DIR@|$platform_index_dir|g" -e "s|@PLUGIN_INDEX_DIR@|$plugin_index_dir|g" -e "s|@LOCKED_RUBY_INDEX_DIR@|$locked_ruby_index_dir|g" -e "s|@PLUGIN_SOURCE_INDEX_DIR@|$plugin_source_index_dir|g" -e "s|@PLUGIN_GEM_INDEX_DIR@|$plugin_gem_index_dir|g" -e "s|@LEGACY_INDEX_DIR@|$legacy_index_dir|g" -e "s|@RUBY_VERSIONS_INDEX_DIR@|$ruby_versions_index_dir|g" -e "s|@BUNDLER_VERSION@|$bundler_version|g")"
    ref_n=$((ref_n + 1))
    (
      cd "$ref_sandbox/project" || exit 99
      env "${isolated_env[@]}" ruby "$bundler_exe" $cmd
    ) > "$work/ref.part.$ref_n.out" 2> "$work/ref.part.$ref_n.err"
    ref_code=$?
  done 3< "$fixture_dir/command"
  ref_parts=(); ref_err_parts=()
  for i in $(seq 1 "$ref_n"); do
    ref_parts+=("$work/ref.part.$i.out")
    ref_err_parts+=("$work/ref.part.$i.err")
  done
  # Single `cat` with one open of the destination: opening the same file for
  # append twice in this MSYS bash resets the write offset to 0, which truncated
  # the concatenation again. `cat a b > out` opens `out` exactly once.
  cat "${ref_parts[@]}" > "$work/ref.out"
  cat "${ref_err_parts[@]}" > "$work/ref.err"

  # Celerite run(s) — same per-command capture.
  : > "$work/cel.out"; : > "$work/cel.err"; cel_code=0; cel_n=0
  while IFS= read -r cmd <&4; do
    [ -z "$cmd" ] && continue
    cmd="$(printf '%s' "$cmd" | sed -e "s|@INDEX_DIR@|$index_dir|g" -e "s|@SCOPED_INDEX_DIR@|$scoped_index_dir|g" -e "s|@LOCKED_DEPS_INDEX_DIR@|$locked_deps_index_dir|g" -e "s|@RUBY_CONSTRAINTS_INDEX_DIR@|$ruby_constraints_index_dir|g" -e "s|@PLATFORM_INDEX_DIR@|$platform_index_dir|g" -e "s|@PLUGIN_INDEX_DIR@|$plugin_index_dir|g" -e "s|@LOCKED_RUBY_INDEX_DIR@|$locked_ruby_index_dir|g" -e "s|@PLUGIN_SOURCE_INDEX_DIR@|$plugin_source_index_dir|g" -e "s|@PLUGIN_GEM_INDEX_DIR@|$plugin_gem_index_dir|g" -e "s|@LEGACY_INDEX_DIR@|$legacy_index_dir|g" -e "s|@RUBY_VERSIONS_INDEX_DIR@|$ruby_versions_index_dir|g" -e "s|@BUNDLER_VERSION@|$bundler_version|g")"
    cel_n=$((cel_n + 1))
    (
      cd "$cel_sandbox/project" || exit 99
      env HOME="$cel_sandbox/home" USERPROFILE="$cel_sandbox/home" \
        GEM_HOME="$cel_sandbox/gems" GEM_PATH="$cel_sandbox/gems" \
        BUNDLE_PATH="$cel_sandbox/bundle" RUBYOPT="" \
        TMP="$work_tmp_win" TEMP="$work_tmp_win" TMPDIR="$work/tmp" \
        ${frozen_env:+BUNDLE_FROZEN=true} \
        ${deploy_env:+BUNDLE_DEPLOYMENT=true} \
        CELERITE_REFERENCE_BUNDLER_LIB="$bundler_lib" \
        CELERITE_PROFILE_BUNDLER_VERSION="$bundler_version" \
        "$celerite_bin" $cmd
    ) > "$work/cel.part.$cel_n.out" 2> "$work/cel.part.$cel_n.err"
    cel_code=$?
  done 4< "$fixture_dir/command"
  cel_parts=(); cel_err_parts=()
  for i in $(seq 1 "$cel_n"); do
    cel_parts+=("$work/cel.part.$i.out")
    cel_err_parts+=("$work/cel.part.$i.err")
  done
  cat "${cel_parts[@]}" > "$work/cel.out"
  cat "${cel_err_parts[@]}" > "$work/cel.err"

  if [ -n "$http_server_pid" ]; then
    kill "$http_server_pid" 2>/dev/null || true
    wait "$http_server_pid" 2>/dev/null || true
  fi

  normalize "$ref_sandbox" "$cel_sandbox" < "$work/ref.out" > "$work/ref.out.n"
  normalize "$ref_sandbox" "$cel_sandbox" < "$work/cel.out" > "$work/cel.out.n"
  normalize "$ref_sandbox" "$cel_sandbox" < "$work/ref.err" > "$work/ref.err.n"
  normalize "$ref_sandbox" "$cel_sandbox" < "$work/cel.err" > "$work/cel.err.n"

  # Preserve sandboxes for post-mortem inspection on failure:
  #   KEEP_DIFFERENTIAL=1 script/differential <fixture>
  if [ "${KEEP_DIFFERENTIAL:-0}" != "1" ]; then
    :
  fi

  local ok=1
  local detail=""
  if [ "$ref_code" != "$cel_code" ]; then
    ok=0; detail+="  exit code: reference=$ref_code celerite=$cel_code"$'\n'
  fi
  if ! diff -q "$work/ref.out.n" "$work/cel.out.n" >/dev/null; then
    ok=0; detail+="  stdout differs:"$'\n'"$(diff "$work/ref.out.n" "$work/cel.out.n" | head -15)"$'\n'
  fi
  # Optional `stderr-contains` marker: each non-empty line is one verbatim
  # needle that must appear on both sides (a line is the needle as a whole;
  # there is no tab splitting here, unlike the path/needle pairs of
  # `file-contains`). When at least one needle is present the stderr
  # comparison is contains-only (declared normalization N10); it exists for
  # reference crash reports whose backtrace embeds machine paths that cannot
  # be reproduced verbatim. An empty marker file (or one holding only blank
  # lines) is treated exactly as if the marker were absent: the exact stderr
  # comparison stays on and no N10 note is printed. Only fixtures that opt in
  # are affected.
  local stderr_contains=0
  local -a stderr_needles=()
  if [ -f "$fixture_dir/stderr-contains" ]; then
    while IFS= read -r needle; do
      needle="$(printf '%s' "$needle" | tr -d '\r' | sed -e "s|@INDEX_DIR@|$index_dir|g" -e "s|@SCOPED_INDEX_DIR@|$scoped_index_dir|g" -e "s|@LOCKED_DEPS_INDEX_DIR@|$locked_deps_index_dir|g" -e "s|@RUBY_CONSTRAINTS_INDEX_DIR@|$ruby_constraints_index_dir|g" -e "s|@PLATFORM_INDEX_DIR@|$platform_index_dir|g" -e "s|@PLUGIN_INDEX_DIR@|$plugin_index_dir|g" -e "s|@LOCKED_RUBY_INDEX_DIR@|$locked_ruby_index_dir|g" -e "s|@PLUGIN_SOURCE_INDEX_DIR@|$plugin_source_index_dir|g" -e "s|@PLUGIN_GEM_INDEX_DIR@|$plugin_gem_index_dir|g" -e "s|@LEGACY_INDEX_DIR@|$legacy_index_dir|g" -e "s|@RUBY_VERSIONS_INDEX_DIR@|$ruby_versions_index_dir|g" -e "s|@BUNDLER_VERSION@|$bundler_version|g")"
      [ -z "$needle" ] && continue
      stderr_needles+=("$needle")
    done < "$fixture_dir/stderr-contains"
  fi
  if [ "${#stderr_needles[@]}" -gt 0 ]; then
    stderr_contains=1
    local needle
    for needle in "${stderr_needles[@]}"; do
      if ! grep -Fq -- "$needle" "$work/ref.err" 2>/dev/null || \
         ! grep -Fq -- "$needle" "$work/cel.err" 2>/dev/null; then
        ok=0; detail+="  stderr-contains differs: needle=$needle"$'\n'
      fi
    done
    printf '    stderr compared by contains only (declared normalization N10)\n'
  fi
  if [ "$stderr_contains" = 0 ] && ! diff -q "$work/ref.err.n" "$work/cel.err.n" >/dev/null; then
    ok=0; detail+="  stderr differs:"$'\n'"$(diff "$work/ref.err.n" "$work/cel.err.n" | head -15)"$'\n'
  fi
  # Tree comparison: path-only differences (per-sandbox paths inside
  # generated files like the plugin index) are normalized; pure "Files A and
  # B differ" duplicates vanish after normalization, real content
  # differences and missing/extra files remain.
  local norm_tree
  norm_tree="$(diff -r --brief "$ref_sandbox/project" "$cel_sandbox/project" 2>/dev/null | normalize "$ref_sandbox" "$cel_sandbox" | grep -v "^Files .* differ$")"
  if [ -n "$norm_tree" ]; then
    ok=0; detail+="  project tree differs:"$'\n'"$norm_tree"$'\n'
  fi
  # Optional `installed-tree` marker: compare the bundle install tree
  # (relative path sets, file contents and POSIX executable bits). See
  # script/differential-installed-tree for the exact rules.
  if [ -f "$fixture_dir/installed-tree" ]; then
    local installed_diff
    if ! installed_diff="$(compare_installed_tree "$ref_sandbox" "$cel_sandbox" "$fixture_dir/installed-tree" "$ref_sandbox/bundle" "$cel_sandbox/bundle")"; then
      ok=0; detail+="  installed tree differs:"$'
'"$installed_diff"
    fi
  fi

  # Optional `first-line` marker: first line of the named project file must
  # match (content probe — the tree compare above is path-only, e.g.
  # binstub shebangs).
  if [ -f "$fixture_dir/first-line" ]; then
    rel="$(tr -d '\r' < "$fixture_dir/first-line" | head -1)"
    ref_line="$(head -1 "$ref_sandbox/project/$rel" 2>/dev/null)"
    cel_line="$(head -1 "$cel_sandbox/project/$rel" 2>/dev/null)"
    if [ "$ref_line" != "$cel_line" ]; then
      ok=0; detail+="  first-line differs ($rel): ref=$ref_line cel=$cel_line"$'\n'
    fi
  fi
  # Optional `file-equals` marker: the first line is a project-relative path
  # and the remaining lines are the exact expected file body. The
  # `file-equals-<BUNDLER_VERSION>` variant overrides it for that profile
  # (CHECKSUMS sections differ: 4.0.24 records a bundler self-checksum, 2.7.x
  # drops it). Placeholders such as @BUNDLER_VERSION@ are substituted.
  local equals_marker="$fixture_dir/file-equals"
  if [ -f "$fixture_dir/file-equals-$bundler_version" ]; then
    equals_marker="$fixture_dir/file-equals-$bundler_version"
  fi
  if [ -f "$equals_marker" ]; then
    local rel expected_file side actual_file
    rel="$(head -1 "$equals_marker" | tr -d '\r')"
    expected_file="$work/file-equals.expected"
    tail -n +2 "$equals_marker" | sed -e "s|@INDEX_DIR@|$index_dir|g" -e "s|@PLUGIN_SOURCE_INDEX_DIR@|$plugin_source_index_dir|g" -e "s|@PLUGIN_GEM_INDEX_DIR@|$plugin_gem_index_dir|g" -e "s|@LEGACY_INDEX_DIR@|$legacy_index_dir|g" -e "s|@RUBY_VERSIONS_INDEX_DIR@|$ruby_versions_index_dir|g" -e "s|@BUNDLER_VERSION@|$bundler_version|g" > "$expected_file"
    for side in ref cel; do
      if [ "$side" = "ref" ]; then actual_file="$ref_sandbox/project/$rel"; else actual_file="$cel_sandbox/project/$rel"; fi
      if ! diff -q "$expected_file" "$actual_file" >/dev/null 2>&1; then
        ok=0; detail+="  file-equals differs ($rel, $side):"$'\n'"$(diff "$expected_file" "$actual_file" | head -15)"$'\n'
      fi
    done
  fi

  # Optional `file-contains` marker: each TSV line is `<path>\t<needle>` and
  # the needle must appear verbatim in that project file on both sides
  # (content probe for Gemfile lines emitted by `bundle add`).
  if [ -f "$fixture_dir/file-contains" ]; then
    while IFS=$'\t' read -r rel needle; do
      [ -z "$rel" ] && continue
      needle="$(printf '%s' "$needle" | sed -e "s|@INDEX_DIR@|$index_dir|g" -e "s|@SCOPED_INDEX_DIR@|$scoped_index_dir|g" -e "s|@LOCKED_DEPS_INDEX_DIR@|$locked_deps_index_dir|g" -e "s|@RUBY_CONSTRAINTS_INDEX_DIR@|$ruby_constraints_index_dir|g" -e "s|@PLATFORM_INDEX_DIR@|$platform_index_dir|g" -e "s|@PLUGIN_INDEX_DIR@|$plugin_index_dir|g" -e "s|@LOCKED_RUBY_INDEX_DIR@|$locked_ruby_index_dir|g" -e "s|@PLUGIN_SOURCE_INDEX_DIR@|$plugin_source_index_dir|g" -e "s|@PLUGIN_GEM_INDEX_DIR@|$plugin_gem_index_dir|g" -e "s|@LEGACY_INDEX_DIR@|$legacy_index_dir|g" -e "s|@RUBY_VERSIONS_INDEX_DIR@|$ruby_versions_index_dir|g" -e "s|@BUNDLER_VERSION@|$bundler_version|g")"
      if ! grep -Fq -- "$needle" "$ref_sandbox/project/$rel" 2>/dev/null || \
         ! grep -Fq -- "$needle" "$cel_sandbox/project/$rel" 2>/dev/null; then
        ok=0; detail+="  file-contains differs ($rel): needle=$needle"$'\n'
      fi
    done < "$fixture_dir/file-contains"
  fi

  # Optional `file-absent` marker: each non-empty line names a project-relative
  # path that must be absent on BOTH sides (e.g. no Gemfile.lock after a failed
  # install). Path-only tree comparison cannot express "this file must not
  # exist"; it would match two sides that both created it. An empty marker file
  # (or one holding only blank lines) equals "marker not provided": no check.
  if [ -f "$fixture_dir/file-absent" ]; then
    while IFS= read -r rel; do
      rel="$(printf '%s' "$rel" | tr -d '\r')"
      [ -z "$rel" ] && continue
      ref_exists=no
      cel_exists=no
      [ -e "$ref_sandbox/project/$rel" ] && ref_exists=yes
      [ -e "$cel_sandbox/project/$rel" ] && cel_exists=yes
      if [ "$ref_exists" != "no" ] || [ "$cel_exists" != "no" ]; then
        ok=0; detail+="  file-absent violated ($rel): ref_exists=$ref_exists cel_exists=$cel_exists"$'\n'
      fi
    done < "$fixture_dir/file-absent"
  fi

  # Optional `file-crlf` marker: each line names a project file that must keep
  # at least one CRLF and no lone LF bytes on both sides (lockfile line-ending
  # parity; reference definition.rb:428-434 preserves the on-disk style).
  if [ -f "$fixture_dir/file-crlf" ]; then
    while IFS= read -r rel; do
      rel="$(printf '%s' "$rel" | tr -d '\r')"
      [ -z "$rel" ] && continue
      for side in ref cel; do
        sandbox="$ref_sandbox"
        [ "$side" = "cel" ] && sandbox="$cel_sandbox"
        if [ "${bundler_version%%.*}" = "2" ]; then
          # 2.7.x reads the existing lock in text mode on Windows, so its own
          # `match?("\r\n")` never fires and the reference normalizes to LF;
          # the product mirrors that profile, so this side must be LF.
          crlf_msg="$(ruby -e 'd=File.binread(ARGV[0]); abort "unexpected CRLF (2.7.x normalizes to LF)" if d.include?("\r\n")' "$sandbox/project/$rel" 2>&1)" || {
            ok=0; detail+="  file-crlf differs ($rel, $side): $crlf_msg"$'\n'
          }
        else
          crlf_msg="$(ruby -e 'd=File.binread(ARGV[0]); abort "missing CRLF" unless d.include?("\r\n"); i=d.index(/(?<!\r)\n/n); abort "lone LF at byte #{i}" if i' "$sandbox/project/$rel" 2>&1)" || {
            ok=0; detail+="  file-crlf differs ($rel, $side): $crlf_msg"$'\n'
          }
        fi
      done
    done < "$fixture_dir/file-crlf"
  fi

  if [ "$ok" = 1 ]; then
    echo "PASS $name (exit=$ref_code)"
    pass=$((pass + 1))
    [ "${KEEP_DIFFERENTIAL:-0}" = "1" ] || rm -rf "$work"
  else
    echo "FAIL $name ($command_line)"
    echo "$detail" | sed 's/^/    /'
    if [ "${KEEP_DIFFERENTIAL:-0}" = "1" ]; then
      echo "    sandboxes kept at: $work"
    else
      rm -rf "$work"
    fi
    fail=$((fail + 1))
  fi
}

fixtures=()
if [ ${#selected[@]} -gt 0 ]; then
  for name in "${selected[@]}"; do
    fixtures+=("$fixtures_root/$name")
  done
else
  for dir in "$fixtures_root"/*/; do
    fixtures+=("${dir%/}")
  done
fi

for fixture in "${fixtures[@]}"; do
  [ -f "$fixture/command" ] || continue
  if [ -f "$fixture/deferred-$bundler_version" ]; then
    echo "SKIP $(basename "$fixture") (deferred for $bundler_version: $(head -1 "$fixture/deferred-$bundler_version"))"
    skipped=$((skipped + 1))
    continue
  fi
  run_fixture "$fixture"
done

echo
echo "differential ($bundler_version): $pass passed, $fail failed, $skipped skipped (documented deferrals)"
[ "$fail" -eq 0 ]
