#!/usr/bin/env bash
# Differential test harness (M0): runs the same fixture through the pinned
# reference Bundler and Celerite in isolated sandboxes, then compares exit
# codes, stdout, stderr and the resulting project file tree after normalizing
# sandbox paths.
#
# Usage:
#   script/differential                # all fixtures, bundler 4.0.24
#   script/differential <fixture>...   # selected fixtures
#   BUNDLER_REF_VERSION=2.7.2 script/differential
#
# Reference Bundler versions must be installed with `gem install bundler -v <v>`
# (see vendor/reference/MANIFEST.md). The harness requires no network: fixtures
# are lockfile-driven and every command runs with empty isolated gem homes.
# Normalization rules applied to both sides (complete list; see
# docs/differential-normalization.md):
#   N1 sandbox paths (native + MSYS spelling) -> {SANDBOX}
#   N2 CRLF -> LF
#   N3 ISO timestamps -> {TIMESTAMP}
#   N4 calendar dates -> {DATE}
#   N5 `## Environment` body (until `## Bundle Doctor`) dropped
#   N6 Ruby backtrace `   from ...` frames dropped
#   N7 runs of consecutive `Fetching ` lines sorted (parallel download order)
# Exit codes, all other line ordering, trees and file contents must match.
set -uo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
bundler_version="${BUNDLER_REF_VERSION:-4.0.24}"
# CELERITE_BIN overrides the engine under test (e.g. a gem-installed shim:
# CELERITE_BIN="$gem_home/bin/celerite" script/differential <fixture>)
celerite_bin="${CELERITE_BIN:-$repo_root/bin/celerite}"
fixtures_root="$repo_root/fixtures/differential"
selected=("$@")

if [ ! -x "$celerite_bin" ]; then
  (cd "$repo_root" && shards build >/dev/null) || { echo "celerite build failed" >&2; exit 2; }
fi

bundler_paths="$(ruby -e 'begin
  spec = Gem::Specification.find_by_name("bundler", ARGV[0])
  puts File.join(spec.full_gem_path, "exe", "bundle")
  puts File.join(spec.full_gem_path, "lib")
rescue Gem::LoadError
  abort "bundler #{ARGV[0]} is not installed; see vendor/reference/MANIFEST.md"
end' "$bundler_version")" || exit 2
bundler_exe="$(echo "$bundler_paths" | head -1)"
bundler_lib="$(echo "$bundler_paths" | tail -1)"

normalize() {
  # $1 = reference sandbox, $2 = celerite sandbox
  # Program output uses Windows paths; the sandbox vars are MSYS paths, so
  # normalize both spellings.
  local ref_win="$(cygpath -m "$1" 2>/dev/null || echo "$1")"
  local cel_win="$(cygpath -m "$2" 2>/dev/null || echo "$2")"
  sed -e "s|$1|{SANDBOX}|g" \
      -e "s|$2|{SANDBOX}|g" \
      -e "s|$ref_win|{SANDBOX}|g" \
      -e "s|$cel_win|{SANDBOX}|g" \
      -e 's/\r$//' \
      -e 's/[0-9][0-9-]*T[0-9:.+-]*Z/{TIMESTAMP}/g' \
      -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}/{DATE}/g' \
      -e '/^## Environment$/,/^## Bundle Doctor$/{/^## Bundle Doctor$/!d}' \
      -e '/^[ 	]*from /d' \
    | awk '
        /^Fetching / { buf[n++] = $0; next }
        {
          if (n > 0) {
            for (i = 1; i < n; i++) {
              v = buf[i]
              for (j = i - 1; j >= 0 && buf[j] > v; j--) buf[j+1] = buf[j]
              buf[j+1] = v
            }
            for (i = 0; i < n; i++) print buf[i]
            n = 0
          }
          print
        }
        END {
          for (i = 1; i < n; i++) {
            v = buf[i]
            for (j = i - 1; j >= 0 && buf[j] > v; j--) buf[j+1] = buf[j]
            buf[j+1] = v
          }
          for (i = 0; i < n; i++) print buf[i]
        }
      '
}

pass=0
fail=0
skipped=0

run_fixture() {
  local fixture_dir="$1"
  local name
  name="$(basename "$fixture_dir")"
  # Multiple lines = multiple sequential runs (e.g. install reruns)
  command_line="$(cat "$fixture_dir/command")"

  local work
  work="$(mktemp -d)"
  local ref_sandbox="$work/reference"
  local cel_sandbox="$work/celerite"
  mkdir -p "$ref_sandbox/project" "$ref_sandbox/home" "$ref_sandbox/gems" "$ref_sandbox/bundle"
  mkdir -p "$cel_sandbox/project" "$cel_sandbox/home" "$cel_sandbox/gems" "$cel_sandbox/bundle"

  # Ruby (native Windows) needs a Windows path for file:// sources
  index_dir="$(cygpath -m "$repo_root/fixtures/gem-index" 2>/dev/null || echo "$repo_root/fixtures/gem-index")"
  scoped_index_dir="$(cygpath -m "$repo_root/fixtures/gem-index-scoped" 2>/dev/null || echo "$repo_root/fixtures/gem-index-scoped")"
  index_url="file://$index_dir"
  for side in ref cel; do
    sandbox="$ref_sandbox"; [ "$side" = "cel" ] && sandbox="$cel_sandbox"
    for f in Gemfile Gemfile.lock; do
      [ -f "$fixture_dir/$f" ] || continue
      sed -e "s|@INDEX_DIR@|$index_dir|" -e "s|@SCOPED_INDEX_DIR@|$scoped_index_dir|" -e "s|@BUNDLER_VERSION@|$bundler_version|"         "$fixture_dir/$f" > "$sandbox/project/$f"
    done
  done
  # extra files, if any (including dotfiles such as .bundle/config: `*` glob
  # would miss them, so gate on directory existence instead)
  if [ -d "$fixture_dir/extra" ]; then
    cp -r "$fixture_dir/extra/." "$ref_sandbox/project/"
    cp -r "$fixture_dir/extra/." "$cel_sandbox/project/"
    # substitute placeholders in extra text files (scripts, configs)
    for side in ref cel; do
      sandbox="$ref_sandbox"; [ "$side" = "cel" ] && sandbox="$cel_sandbox"
      while IFS= read -r ef; do
        sed -i -e "s|@INDEX_DIR@|$index_dir|g" -e "s|@SCOPED_INDEX_DIR@|$scoped_index_dir|g" -e "s|@BUNDLER_VERSION@|$bundler_version|g" "$ef"
      done < <(find "$sandbox/project" -type f \( -name "*.rb" -o -name "*.txt" \) 2>/dev/null)
    done
  fi

  # Git-source fixtures: nested .git directories cannot be committed, so each
  # directory listed in the fixture's `git-init` manifest is materialized here
  # as a real repo. One staging init per side keeps both runs on the same
  # commit SHA (deterministic author/committer env pins the SHA).
  if [ -f "$fixture_dir/git-init" ]; then
    staging="$(mktemp -d)"
    while IFS= read -r rel; do
      [ -d "$fixture_dir/extra/$rel" ] || continue
      rm -rf "$staging/$rel"
      mkdir -p "$staging/$rel"
      cp -r "$fixture_dir/extra/$rel/." "$staging/$rel/"
      rm -rf "$staging/$rel/.git"
      GIT_AUTHOR_NAME=fixture GIT_AUTHOR_EMAIL=fixture@example.test \
      GIT_COMMITTER_NAME=fixture GIT_COMMITTER_EMAIL=fixture@example.test \
      GIT_AUTHOR_DATE="2026-01-01T00:00:00Z" GIT_COMMITTER_DATE="2026-01-01T00:00:00Z" \
        git -C "$staging/$rel" -c core.autocrlf=false -c commit.gpgsign=false \
        init -q -b master >/dev/null
      git -C "$staging/$rel" -c core.autocrlf=false add -A
      GIT_AUTHOR_NAME=fixture GIT_AUTHOR_EMAIL=fixture@example.test \
      GIT_COMMITTER_NAME=fixture GIT_COMMITTER_EMAIL=fixture@example.test \
      GIT_AUTHOR_DATE="2026-01-01T00:00:00Z" GIT_COMMITTER_DATE="2026-01-01T00:00:00Z" \
        git -C "$staging/$rel" -c commit.gpgsign=false commit -q -m init
      for side in ref cel; do
        sandbox="$ref_sandbox"; [ "$side" = "cel" ] && sandbox="$cel_sandbox"
        rm -rf "$sandbox/project/$rel"
        cp -r "$staging/$rel" "$sandbox/project/$rel"
      done
    done < "$fixture_dir/git-init"
    rm -rf "$staging"
  fi

  local isolated_env=(
    HOME="$ref_sandbox/home" USERPROFILE="$ref_sandbox/home"
    GEM_HOME="$ref_sandbox/gems" GEM_PATH="$ref_sandbox/gems"
    BUNDLE_PATH="$ref_sandbox/bundle" RUBYOPT=""
  )

  # HTTP-index fixtures (http-index marker): serve fixtures/gem-index as a
  # v2 compact-index HTTP root so cooldown/ETag behavior matches rubygems.org
  # semantics that file:// marshal indexes never exercise.
  http_server_pid=""
  if [ -f "$fixture_dir/http-index" ]; then
    node "$repo_root/script/http_index_server.js" "$repo_root/fixtures/gem-index" 8765 >/dev/null 2>&1 &
    http_server_pid=$!
  fi

  # Reference run(s): one per command line (multi-line command files run the
  # commands in sequence), outputs concatenated, last exit code kept. Loops
  # use dedicated fds so the sandboxed commands cannot eat the command list.
  : > "$work/ref.out"; : > "$work/ref.err"; ref_code=0
  while IFS= read -r cmd <&3; do
    [ -z "$cmd" ] && continue
    cmd="$(printf '%s' "$cmd" | sed -e "s|@INDEX_DIR@|$index_dir|g" -e "s|@SCOPED_INDEX_DIR@|$scoped_index_dir|g" -e "s|@BUNDLER_VERSION@|$bundler_version|g")"
    (
      cd "$ref_sandbox/project" || exit 99
      env "${isolated_env[@]}" ruby "$bundler_exe" $cmd
    ) >> "$work/ref.out" 2>> "$work/ref.err"
    ref_code=$?
  done 3< "$fixture_dir/command"

  # Celerite run(s)
  : > "$work/cel.out"; : > "$work/cel.err"; cel_code=0
  while IFS= read -r cmd <&4; do
    [ -z "$cmd" ] && continue
    cmd="$(printf '%s' "$cmd" | sed -e "s|@INDEX_DIR@|$index_dir|g" -e "s|@SCOPED_INDEX_DIR@|$scoped_index_dir|g" -e "s|@BUNDLER_VERSION@|$bundler_version|g")"
    (
      cd "$cel_sandbox/project" || exit 99
      env HOME="$cel_sandbox/home" USERPROFILE="$cel_sandbox/home" \
        GEM_HOME="$cel_sandbox/gems" GEM_PATH="$cel_sandbox/gems" \
        BUNDLE_PATH="$cel_sandbox/bundle" RUBYOPT="" \
        CELERITE_REFERENCE_BUNDLER_LIB="$bundler_lib" \
        CELERITE_PROFILE_BUNDLER_VERSION="$bundler_version" \
        "$celerite_bin" $cmd
    ) >> "$work/cel.out" 2>> "$work/cel.err"
    cel_code=$?
  done 4< "$fixture_dir/command"

  if [ -n "$http_server_pid" ]; then
    kill "$http_server_pid" 2>/dev/null || true
  fi

  normalize "$ref_sandbox" "$cel_sandbox" < "$work/ref.out" > "$work/ref.out.n"
  normalize "$ref_sandbox" "$cel_sandbox" < "$work/cel.out" > "$work/cel.out.n"
  normalize "$ref_sandbox" "$cel_sandbox" < "$work/ref.err" > "$work/ref.err.n"
  normalize "$ref_sandbox" "$cel_sandbox" < "$work/cel.err" > "$work/cel.err.n"

  local ok=1
  local detail=""
  if [ "$ref_code" != "$cel_code" ]; then
    ok=0; detail+="  exit code: reference=$ref_code celerite=$cel_code"$'\n'
  fi
  if ! diff -q "$work/ref.out.n" "$work/cel.out.n" >/dev/null; then
    ok=0; detail+="  stdout differs:"$'\n'"$(diff "$work/ref.out.n" "$work/cel.out.n" | head -15)"$'\n'
  fi
  if ! diff -q "$work/ref.err.n" "$work/cel.err.n" >/dev/null; then
    ok=0; detail+="  stderr differs:"$'\n'"$(diff "$work/ref.err.n" "$work/cel.err.n" | head -15)"$'\n'
  fi
  # Tree comparison: path-only differences (per-sandbox paths inside
  # generated files like the plugin index) are normalized; pure "Files A and
  # B differ" duplicates vanish after normalization, real content
  # differences and missing/extra files remain.
  local norm_tree
  norm_tree="$(diff -r --brief "$ref_sandbox/project" "$cel_sandbox/project" 2>/dev/null | normalize "$ref_sandbox" "$cel_sandbox" | grep -v "^Files .* differ$")"
  if [ -n "$norm_tree" ]; then
    ok=0; detail+="  project tree differs:"$'\n'"$norm_tree"$'\n'
  fi
  # Optional `first-line` marker: first line of the named project file must
  # match (content probe — the tree compare above is path-only, e.g.
  # binstub shebangs).
  if [ -f "$fixture_dir/first-line" ]; then
    rel="$(tr -d '\r' < "$fixture_dir/first-line" | head -1)"
    ref_line="$(head -1 "$ref_sandbox/project/$rel" 2>/dev/null)"
    cel_line="$(head -1 "$cel_sandbox/project/$rel" 2>/dev/null)"
    if [ "$ref_line" != "$cel_line" ]; then
      ok=0; detail+="  first-line differs ($rel): ref=$ref_line cel=$cel_line"$'\n'
    fi
  fi
  # Optional `file-contains` marker: each TSV line is `<path>\t<needle>` and
  # the needle must appear verbatim in that project file on both sides
  # (content probe for Gemfile lines emitted by `bundle add`).
  if [ -f "$fixture_dir/file-contains" ]; then
    while IFS=$'\t' read -r rel needle; do
      [ -z "$rel" ] && continue
      needle="$(printf '%s' "$needle" | sed -e "s|@INDEX_DIR@|$index_dir|g" -e "s|@SCOPED_INDEX_DIR@|$scoped_index_dir|g" -e "s|@BUNDLER_VERSION@|$bundler_version|g")"
      if ! grep -Fq -- "$needle" "$ref_sandbox/project/$rel" 2>/dev/null || \
         ! grep -Fq -- "$needle" "$cel_sandbox/project/$rel" 2>/dev/null; then
        ok=0; detail+="  file-contains differs ($rel): needle=$needle"$'\n'
      fi
    done < "$fixture_dir/file-contains"
  fi

  if [ "$ok" = 1 ]; then
    echo "PASS $name (exit=$ref_code)"
    pass=$((pass + 1))
  else
    echo "FAIL $name ($command_line)"
    echo "$detail" | sed 's/^/    /'
    fail=$((fail + 1))
  fi
}

fixtures=()
if [ ${#selected[@]} -gt 0 ]; then
  for name in "${selected[@]}"; do
    fixtures+=("$fixtures_root/$name")
  done
else
  for dir in "$fixtures_root"/*/; do
    fixtures+=("${dir%/}")
  done
fi

for fixture in "${fixtures[@]}"; do
  [ -f "$fixture/command" ] || continue
  if [ -f "$fixture/deferred-$bundler_version" ]; then
    echo "SKIP $(basename "$fixture") (deferred for $bundler_version: $(head -1 "$fixture/deferred-$bundler_version"))"
    skipped=$((skipped + 1))
    continue
  fi
  run_fixture "$fixture"
done

echo
echo "differential ($bundler_version): $pass passed, $fail failed, $skipped skipped (documented deferrals)"
[ "$fail" -eq 0 ]
