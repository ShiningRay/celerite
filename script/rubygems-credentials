#!/usr/bin/env bash
# Exchange a GitHub Actions OIDC token for a short-lived RubyGems API key.
#
# RubyGems requires the `owner` parameter when the workflow creates a gem for
# the first time. configure-rubygems-credentials@v2.1.0 does not expose that
# input yet, so this script performs the documented exchange directly.
#
# Usage: script/rubygems-credentials <rubygems-owner-handle-or-id>
#
# The key is written to stdout only; the caller must mask it and export
# GEM_HOST_API_KEY. Requires the job to grant `id-token: write`.
set -euo pipefail

owner="${1:?usage: script/rubygems-credentials <rubygems-owner-handle-or-id>}"
: "${ACTIONS_ID_TOKEN_REQUEST_URL:?missing ACTIONS_ID_TOKEN_REQUEST_URL}"
: "${ACTIONS_ID_TOKEN_REQUEST_TOKEN:?missing ACTIONS_ID_TOKEN_REQUEST_TOKEN}"

id_token="$(curl -fsS \
  -H "Authorization: bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" \
  "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=rubygems.org" | jq -r .value)"
if [ -z "$id_token" ] || [ "$id_token" = "null" ]; then
  echo "failed to obtain a GitHub Actions OIDC token" >&2
  exit 1
fi

if ! response="$(curl -fsS -X POST \
  -H "content-type: application/json" \
  -H "accept: application/json" \
  --data "$(jq -n --arg jwt "$id_token" --arg owner "$owner" '{jwt: $jwt, owner: $owner}')" \
  "https://rubygems.org/api/v1/oidc/trusted_publisher/exchange_token")"; then
  echo "rubygems OIDC token exchange failed" >&2
  exit 1
fi

api_key="$(printf '%s' "$response" | jq -r .rubygems_api_key)"
if [ -z "$api_key" ] || [ "$api_key" = "null" ]; then
  echo "rubygems OIDC token exchange returned no API key: $response" >&2
  exit 1
fi

printf '%s' "$api_key"
