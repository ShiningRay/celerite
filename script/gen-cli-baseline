#!/usr/bin/env bash
# Regenerate docs/compat-matrix/generated/cli-<version>.md from the installed
# reference Bundler. Usage: script/gen-cli-baseline [version ...]
# The invoking shell must resolve `bundle` to the Ruby with the reference
# Bundlers installed (see vendor/reference/MANIFEST.md).
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
versions=("$@")
[ ${#versions[@]} -eq 0 ] && versions=(4.0.24 2.7.2)
cmds="install update cache package exec config help add binstubs check show info list licenses fund outdated console open lock init gem platform clean pristine doctor env issue remove plugin version"

mkdir -p "$repo_root/docs/compat-matrix/generated"

extract_flags() {
  awk '
    /^\* `/ {
      if (row != "") print row
      flags=$0
      sub(/^\* /, "", flags)
      sub(/:\s*$/, "", flags)
      row = "| " flags " |"
      desc = ""
      next
    }
    row != "" && /^  / {
      d=$0; sub(/^  /, "", d); gsub(/\|/, "\\|", d)
      desc = desc (desc == "" ? "" : " ") d
      next
    }
    row != "" { print row " " desc " |"; row = "" }
    END { if (row != "") print row " " desc " |" }
  '
}

for v in "${versions[@]}"; do
  out="$repo_root/docs/compat-matrix/generated/cli-$v.md"
  echo "# CLI baseline — Bundler $v" > "$out"
  echo >> "$out"
  echo "Generated by \`script/gen-cli-baseline $v\` from \`bundle _${v}_ <cmd> --help\`. Do not hand-edit." >> "$out"
  echo >> "$out"
  for c in $cmds; do
    help="$(bundle _${v}_ "$c" --help 2>&1 | sed 's/\x1b\[[0-9;]*m//g' | tr -d '\r')"
    echo "## $c" >> "$out"
    echo >> "$out"
    printf '%s\n' "$help" | awk '/^## SYNOPSIS/{f=1;next}/^## DESCRIPTION/{f=0}f && NF' | sed 's/^/    /' >> "$out"
    echo >> "$out"
    flags="$(printf '%s\n' "$help" | extract_flags)"
    if [ -n "$flags" ]; then
      echo "| Flag | Description |" >> "$out"
      echo "|---|---|" >> "$out"
      printf '%s\n' "$flags" >> "$out"
    else
      echo "_no flags_" >> "$out"
    fi
    echo >> "$out"
  done
  echo "wrote $out ($(grep -c '^## ' "$out") commands)"
done
