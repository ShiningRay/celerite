#!/usr/bin/env bash
# Release artifacts (roadmap M6): builds the celerite binary for the current
# platform, emits SHA-256 checksums, and packages a self-contained install
# bundle (binary + bundle shim + install scripts) under dist/. Asset names use
# the canonical <os>-<arch> triple consumed by install.sh (curl | bash).
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
version="$(grep -o 'VERSION = ".*"' "$repo_root/src/celerite.cr" | cut -d'"' -f2)"
dist="$repo_root/dist"
mkdir -p "$dist"

echo "Building celerite $version..."
(cd "$repo_root" && shards build --release >/dev/null)

binary="$repo_root/bin/celerite"
[ -f "${binary}.exe" ] && binary="${binary}.exe"
[ -f "$binary" ] || { echo "binary missing" >&2; exit 2; }

# Canonical platform triple (must match install.sh platform detection)
case "$(uname -s)" in
  Linux) os="linux" ;;
  Darwin) os="macos" ;;
  MINGW* | MSYS* | CYGWIN*) os="windows" ;;
  *) os="$(uname -s | tr '[:upper:]' '[:lower:]')" ;;
esac
target="celerite-${version}-${os}-$(uname -m)"

cp "$binary" "$dist/$target"
cp "$repo_root/script/bundle" "$dist/bundle"
# The curl|bash installer is itself a release asset: it is fetched from
# releases/latest/download/install.sh by the user's one-liner.
cp "$repo_root/install.sh" "$dist/install.sh"
chmod 0755 "$dist/install.sh" 2>/dev/null || true

cat > "$dist/install-celerite.sh" <<'INSTALL'
#!/usr/bin/env bash
# Celerite installer (opt-in): copies the binary and the bundle shim into
# ~/.local/bin (or PREFIX/bin). NEVER replaces an existing `bundle` — the shim
# is written as `bundle` only if no bundle exists on PATH; otherwise it is
# installed as `celerite-bundle` with instructions.
set -euo pipefail

prefix="${PREFIX:-$HOME/.local/bin}"
mkdir -p "$prefix"
here="$(cd "$(dirname "$0")" && pwd)"

install -m 0755 "$here/$(ls "$here" | grep '^celerite-' | head -1)" "$prefix/celerite"

if command -v bundle >/dev/null 2>&1; then
  install -m 0755 "$here/bundle" "$prefix/celerite-bundle"
  echo "NOTE: an existing \`bundle\` was found on PATH — the celerite shim was"
  echo "installed as \`celerite-bundle\` (opt-in only, nothing replaced)."
  echo "To use it as \`bundle\`, place $prefix BEFORE the existing bundle on PATH."
else
  install -m 0755 "$here/bundle" "$prefix/bundle"
  echo "Installed celerite bundle shim as \`$prefix/bundle\`."
fi
echo "Installed celerite as \`$prefix/celerite\`."
echo "Verify with: celerite version"
INSTALL
chmod +x "$dist/install-celerite.sh"

cat > "$dist/checksums.sha256" <<HEADER
# SHA-256 checksums for celerite $version
HEADER
(
  cd "$dist"
  # normalize Git Bash binary-mode markers (<hash> *name) to the coreutils
  # text form (<hash>  name) that install.sh and POSIX tools expect
  sha256sum "$target" bundle install-celerite.sh install.sh | sed 's/ \*/  /' >> checksums.sha256
)

# Platform gem (roadmap M6): same binary, packaged for `gem install celerite`.
# The gem is smoke-installed and must answer `celerite version` to count as an
# artifact.
"$repo_root/script/gem"

echo "Artifacts in $dist and $repo_root/pkg:"
ls -la "$dist"
ls -la "$repo_root/pkg"/*.gem
echo
cat "$dist/checksums.sha256"
