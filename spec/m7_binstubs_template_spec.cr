require "./spec_helper"

# Reference anchors for this round:
# * `bundler/binstub.rb:20-27` (4.0.24) / `:14-22` (2.7.2) renders
#   `lib/bundler/templates/Executable`; the stub re-executes `Gem.bin_path`
#   under `bundler/setup` and never copies the gem's own executable.
# * `bundler/binstub.rb:35-37` writes `relative_gemfile_path` as
#   `Pathname.new(gemfile).relative_path_from(bin_path)`.
# * Measured on both profiles: `bin/thor` is 347 bytes, `bin/thor.cmd` is the
#   same body behind `@ruby -x "%~f0" %*` + `@exit /b %ERRORLEVEL%` (389 bytes).
private def binstub_index_remote : String
  file_source_url(File.expand_path(File.join(__DIR__, "..", "fixtures", "gem-index")))
end

private def binstub_gemfile : String
  %(source "#{binstub_index_remote}"\n\ngem "thor"\n)
end

private def with_binstub_env(dir : String, profile : String = "4.0.24", & : ->) : Nil
  keys = {"HOME", "USERPROFILE", "GEM_HOME", "GEM_PATH", "BUNDLE_PATH", "BUNDLE_APP_CONFIG",
          "CELERITE_BRIDGE_SERVER", "CELERITE_PROFILE_BUNDLER_VERSION"}
  saved = keys.map { |key| {key, ENV[key]?} }
  home = File.join(dir, "home")
  Dir.mkdir_p(home)
  ENV["HOME"] = home
  ENV["USERPROFILE"] = home
  ENV.delete("GEM_HOME")
  ENV.delete("GEM_PATH")
  ENV["BUNDLE_PATH"] = File.join(dir, "bundle")
  ENV["BUNDLE_APP_CONFIG"] = File.join(dir, ".bundle")
  ENV["CELERITE_BRIDGE_SERVER"] = File.expand_path("../assets/bridge/server.rb", __DIR__)
  ENV["CELERITE_PROFILE_BUNDLER_VERSION"] = profile
  begin
    yield
  ensure
    saved.each do |(key, value)|
      value ? (ENV[key] = value) : ENV.delete(key)
    end
  end
end

private def binstub_install(dir : String) : Nil
  code, out, err = run_cli(["install", "--quiet"])
  code.should eq(0)
  out.should eq("")
  err.should eq("")
end

describe "binstubs template rendering" do
  it "writes the Bundler Executable template instead of the gem's own executable" do
    with_project({"Gemfile" => binstub_gemfile}) do |dir|
      with_binstub_env(dir) do
        binstub_install(dir)
        code, _out, err = run_cli(["binstubs", "thor"])
        code.should eq(0)
        err.should eq("")
        stub = File.read(File.join(dir, "bin", "thor"))
        stub.should start_with("#!/usr/bin/env ruby\n")
        stub.should contain("# This file was generated by Bundler.")
        stub.should contain(%(ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)))
        stub.should contain(%(load Gem.bin_path("thor", "thor")))
        # The gem's own executable is the thing the old implementation copied.
        stub.should_not contain("thor/runner")
        stub.size.should eq(347)
      end
    end
  end

  it "honours --shebang by replacing only the interpreter line" do
    with_project({"Gemfile" => binstub_gemfile}) do |dir|
      with_binstub_env(dir) do
        binstub_install(dir)
        code, _out, _err = run_cli(["binstubs", "thor", "--shebang", "ruby3"])
        code.should eq(0)
        stub = File.read(File.join(dir, "bin", "thor"))
        stub.each_line(chomp: false).first.should eq("#!/usr/bin/env ruby3\n")
        stub.should contain(%(load Gem.bin_path("thor", "thor")))
      end
    end
  end

  it "computes the Gemfile path relative to the bin directory" do
    with_project({"Gemfile" => binstub_gemfile}) do |dir|
      with_binstub_env(dir) do
        code, _out, _err = run_cli(["config", "set", "bin", "sub/dir"])
        code.should eq(0)
        binstub_install(dir)
        code, _out, _err = run_cli(["binstubs", "thor"])
        code.should eq(0)
        stub = File.read(File.join(dir, "sub", "dir", "thor"))
        stub.should contain(%(File.expand_path("../../Gemfile", __dir__)))
      end
    end
  end

  it "keeps the Windows .cmd wrapper on the rendered body" do
    with_project({"Gemfile" => binstub_gemfile}) do |dir|
      with_binstub_env(dir) do
        binstub_install(dir)
        code, _out, _err = run_cli(["binstubs", "thor"])
        code.should eq(0)
        stub = File.read(File.join(dir, "bin", "thor"))
        cmd = File.read(File.join(dir, "bin", "thor.cmd"))
        cmd.should start_with("@ruby -x \"%~f0\" %*\n@exit /b %ERRORLEVEL%\n\n")
        cmd.should end_with(stub)
        cmd.size.should eq(stub.size + 42)
      end
    end
  end
end
