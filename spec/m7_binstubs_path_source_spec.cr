require "./spec_helper"

# `cli/binstubs.rb:52` -> `installer.rb:121-130`: the reference resolves the
# executables through `Bundler.bin_path` + `spec.full_gem_path`, never through
# the cached `<full_name>.gem`. A PATH source is installed as a directory copy,
# so it has no cached package at all; before task-112 the loop bailed out on
# `next unless File.file?(gem_file)` and silently wrote nothing.
private def binstub_path_remote : String
  file_source_url(File.expand_path(File.join(__DIR__, "..", "fixtures", "gem-index")))
end

private def binstub_path_gemspec(name : String = "ptool", binary : String = "my-tool") : String
  "Gem::Specification.new do |s|\n" +
    "  s.name = \"#{name}\"\n" +
    "  s.version = \"1.0.0\"\n" +
    "  s.summary = \"path tool\"\n" +
    "  s.authors = [\"t\"]\n" +
    "  s.files = [\"bin/#{binary}\", \"lib/#{name}.rb\"]\n" +
    "  s.executables = [\"#{binary}\"]\n" +
    "  s.bindir = \"bin\"\n" +
    "  s.require_paths = [\"lib\"]\n" +
    "end\n"
end

private def binstub_path_project(dir : String, with_json_pure : Bool = true) : Hash(String, String)
  files = {
    "ptool/ptool.gemspec" => binstub_path_gemspec,
    "ptool/bin/my-tool"   => "#!/usr/bin/env ruby\nputs 'tool ok'\n",
    "ptool/lib/ptool.rb"  => "module Ptool; end\n",
    "Gemfile"             => %(source "#{binstub_path_remote}"\n\ngem "ptool", path: "ptool"\n) +
                 (with_json_pure ? %(gem "json_pure"\n) : ""),
  }
  files
end

private def with_binstub_path_env(dir : String, & : ->) : Nil
  # `BUNDLE_GEMFILE` must be restored even though the blocks below set it: the
  # project directory it points into is removed by `with_project` on the way
  # out, so a leaked value would hand the next spec a Gemfile that no longer
  # exists (`install` then exits 1). Inside the block it stays live as before.
  keys = {"HOME", "USERPROFILE", "GEM_HOME", "GEM_PATH", "BUNDLE_PATH", "BUNDLE_APP_CONFIG",
          "BUNDLE_GEMFILE", "CELERITE_BRIDGE_SERVER", "CELERITE_PROFILE_BUNDLER_VERSION"}
  saved = keys.map { |key| {key, ENV[key]?} }
  home = File.join(dir, "home")
  Dir.mkdir_p(home)
  ENV["HOME"] = home
  ENV["USERPROFILE"] = home
  ENV.delete("GEM_HOME")
  ENV.delete("GEM_PATH")
  ENV["BUNDLE_PATH"] = File.join(dir, "bundle")
  ENV["BUNDLE_APP_CONFIG"] = File.join(dir, ".bundle")
  ENV["CELERITE_BRIDGE_SERVER"] = File.expand_path("../assets/bridge/server.rb", __DIR__)
  ENV["CELERITE_PROFILE_BUNDLER_VERSION"] = "4.0.24"
  begin
    yield
  ensure
    saved.each { |key, value| value.nil? ? ENV.delete(key) : (ENV[key] = value) }
  end
end

describe "binstubs for a PATH source" do
  it "writes the stub pair for a gem that has no cached package" do
    dir = File.tempname("celerite-binstub-path", "proj")
    Dir.mkdir_p(dir)
    gemfile_before = ENV["BUNDLE_GEMFILE"]?
    begin
      with_binstub_path_env(dir) do
        with_project(binstub_path_project(dir)) do |project|
          ENV["BUNDLE_GEMFILE"] = File.join(project, "Gemfile")
          code, _out, err = run_cli(["install", "--quiet"])
          code.should eq(0)
          err.should eq("")

          code, out, err = run_cli(["config", "set", "bin", "bin2"])
          code.should eq(0)

          code, out, err = run_cli(["binstubs", "ptool"])
          code.should eq(0)
          out.should eq("")
          err.should eq("")

          stub = File.join(project, "bin2", "my-tool")
          File.file?(stub).should be_true
          File.read(stub).should contain("This file was generated by Bundler.")
          File.file?(stub + ".cmd").should be_true
        end
      end
      ENV["BUNDLE_GEMFILE"]?.should eq(gemfile_before)
    ensure
      FileUtils.rm_rf(dir)
    end
  end

  it "is silent and does not require a cached .gem" do
    dir = File.tempname("celerite-binstub-path", "proj")
    Dir.mkdir_p(dir)
    gemfile_before = ENV["BUNDLE_GEMFILE"]?
    begin
      with_binstub_path_env(dir) do
        with_project(binstub_path_project(dir)) do |project|
          ENV["BUNDLE_GEMFILE"] = File.join(project, "Gemfile")
          run_cli(["install", "--quiet"])
          cache = File.join(dir, "bundle").gsub('\\', "/")
          glob = Dir.glob(File.join(cache, "**", "*.gem")).map(&.gsub('\\', "/"))
          glob.select(&.includes?("ptool")).size.should eq(0)
          code, _out, err = run_cli(["binstubs", "ptool"])
          code.should eq(0)
          err.should eq("")
        end
      end
      ENV["BUNDLE_GEMFILE"]?.should eq(gemfile_before)
    ensure
      FileUtils.rm_rf(dir)
    end
  end

  it "covers the path gem through --all as well" do
    dir = File.tempname("celerite-binstub-path", "proj")
    Dir.mkdir_p(dir)
    gemfile_before = ENV["BUNDLE_GEMFILE"]?
    begin
      with_binstub_path_env(dir) do
        with_project(binstub_path_project(dir)) do |project|
          ENV["BUNDLE_GEMFILE"] = File.join(project, "Gemfile")
          run_cli(["install", "--quiet"])
          code, out, err = run_cli(["binstubs", "--all"])
          code.should eq(0)
          err.should contain("Bundler itself does not use binstubs")
          File.file?(File.join(project, "bin", "my-tool")).should be_true
        end
      end
      ENV["BUNDLE_GEMFILE"]?.should eq(gemfile_before)
    ensure
      FileUtils.rm_rf(dir)
    end
  end
end
