require "spec"
require "file_utils"
require "../src/celerite"
require "../src/celerite/cli"

# Oracle fixture helpers (generated by script/gen-version-oracle from the
# pinned RubyGems reference; see vendor/reference/MANIFEST.md).
def version_oracle : Array(String)
  lines = File.read_lines(File.join(__DIR__, "fixtures", "version_oracle.txt"))
  lines.take_while { |l| !(l.empty? || l.starts_with?("#")) }
end

def each_requirement_oracle(& : (Bool, String, String) ->) : Nil
  File.each_line(File.join(__DIR__, "fixtures", "version_oracle.txt")) do |line|
    next unless line.starts_with?("true\t") || line.starts_with?("false\t")
    satisfied, req, version = line.split("\t")
    yield satisfied == "true", req, version
  end
end

def each_render_oracle(& : (Array(String), String) ->) : Nil
  File.each_line(File.join(__DIR__, "fixtures", "version_oracle.txt")) do |line|
    next unless line.starts_with?("render\t")
    _, reqs, expected = line.split("\t")
    yield reqs.split("|"), expected
  end
end

# Creates an isolated project directory with the given files and yields the
# path with Dir.current pointed at it.
def with_project(files : Hash(String, String), & : String ->) : Nil
  dir = File.tempname("celerite-spec", "proj")
  Dir.mkdir_p(dir)
  files.each do |name, content|
    path = File.join(dir, name)
    parent = File.dirname(path)
    Dir.mkdir_p(parent) unless parent == dir
    File.write(path, content)
  end
  original = Dir.current
  begin
    Dir.cd(dir)
    yield dir
  ensure
    Dir.cd(original)
    FileUtils.rm_rf(dir)
  end
end

def run_cli(args : Array(String)) : {Int32, String, String}
  stdout = IO::Memory.new
  stderr = IO::Memory.new
  code = Celerite::CLI.run(args, stdout, stderr)
  {code, stdout.to_s, stderr.to_s}
end
