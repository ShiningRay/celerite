require "./spec_helper"

# Task-40: guard the deterministic lock shape for a synthetic 8-gem index.
# The index is generated by script/synthetic-index.rb at run time; this spec
# never invokes the reference Bundler (only Celerite's own lock command).
describe "synthetic scale lock" do
  it "keeps the N=8 lockfile byte-stable" do
    pending! "ruby is required to generate the synthetic index" unless ruby_available?

    generator = File.expand_path("../script/synthetic-index.rb", __DIR__)
    index_dir = File.tempname("celerite-synth-spec", "index")
    project_dir = File.tempname("celerite-synth-spec", "project")
    Dir.mkdir_p(project_dir)
    output = IO::Memory.new
    status = Process.run(
      "ruby",
      [generator, "--count", "8", "--out", index_dir],
      output: output,
      error: output
    )
    status.success?.should be_true

    begin
      index_url = file_source_url(index_dir)
      fragment = File.read(File.join(index_dir, "Gemfile.fragment"))
      File.write(File.join(project_dir, "Gemfile"), "source \"#{index_url}\"\n\n#{fragment}\n")

      original = Dir.current
      old_bridge = ENV["CELERITE_BRIDGE_SERVER"]?
      old_profile = ENV["CELERITE_PROFILE_BUNDLER_VERSION"]?
      begin
        ENV["CELERITE_BRIDGE_SERVER"] = File.expand_path("../assets/bridge/server.rb", __DIR__)
        ENV["CELERITE_PROFILE_BUNDLER_VERSION"] = "4.0.24"
        Dir.cd(project_dir)
        code, stdout, stderr = run_cli(["lock"])
        code.should eq(0), "stdout=#{stdout} stderr=#{stderr}"
        stderr.should be_empty
        lock = File.read(File.join(project_dir, "Gemfile.lock"))
        normalized = lock.gsub(/#{Regex.escape(index_url)}\/?/, "file:///__INDEX__/")
        normalized.chomp.should eq(<<-LOCK)
GEM
  remote: file:///__INDEX__/
  specs:
    synth_0001 (1.0.0)
    synth_0002 (1.0.0)
    synth_0003 (1.0.0)
    synth_0004 (1.0.0)
    synth_0005 (1.0.0)
    synth_0006 (1.0.0)
    synth_0007 (1.0.0)
    synth_0008 (1.0.0)

PLATFORMS
  x64-mingw-ucrt

DEPENDENCIES
  synth_0001 (= 1.0.0)
  synth_0002 (= 1.0.0)
  synth_0003 (= 1.0.0)
  synth_0004 (= 1.0.0)
  synth_0005 (= 1.0.0)
  synth_0006 (= 1.0.0)
  synth_0007 (= 1.0.0)
  synth_0008 (= 1.0.0)

CHECKSUMS
  bundler (4.0.24) sha256=16ca64e20816a0cf151a948fb141d788602996d2b4d73577b74388fe84fa98bc
  synth_0001 (1.0.0)
  synth_0002 (1.0.0)
  synth_0003 (1.0.0)
  synth_0004 (1.0.0)
  synth_0005 (1.0.0)
  synth_0006 (1.0.0)
  synth_0007 (1.0.0)
  synth_0008 (1.0.0)

BUNDLED WITH
  4.0.24
LOCK
      ensure
        Dir.cd(original)
        if old_bridge
          ENV["CELERITE_BRIDGE_SERVER"] = old_bridge
        else
          ENV.delete("CELERITE_BRIDGE_SERVER")
        end
        if old_profile
          ENV["CELERITE_PROFILE_BUNDLER_VERSION"] = old_profile
        else
          ENV.delete("CELERITE_PROFILE_BUNDLER_VERSION")
        end
      end
    ensure
      FileUtils.rm_rf(index_dir)
      FileUtils.rm_rf(project_dir)
    end
  end
end
