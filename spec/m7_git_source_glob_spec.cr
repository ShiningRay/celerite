require "./spec_helper"

# Reference `Bundler::Source::Git#initialize` keeps the declared glob
# (`source/git.rb:15` `@glob = options["glob"] || DEFAULT_GLOB`) and
# `Path#initialize` does the same (`source/path.rb:19`); install then only
# materializes binstubs for the spec it already resolved
# (`source/git.rb:201-215` -> `source/path/installer.rb:32`
# `generate_bin unless spec.executables.empty?`) and never re-globs the
# checkout. `Installer#install_source_gem` used to call
# `load_gemspec_dir(source_dir)` with neither the glob nor the name, so the
# bridge fell back to `SOURCE_DEFAULT_GLOB` (`assets/bridge/server.rb:601,564`)
# and raised `no gemspec in <checkout>` (`:615`) for a gem whose gemspec only
# the declared glob reaches -- a hard install failure (exit 1) where the
# reference succeeds. These examples pin both halves of the fix: the declared
# glob must be honored, and a source with no reachable gemspec must not raise.
GIT_GLOB_GEMSPEC = <<-SPEC
  Gem::Specification.new do |s|
    s.name = "alpha"
    s.version = "0.1.0"
    s.summary = "git glob probe"
    s.authors = ["Celerite"]
    s.files = ["bin/alpha-tool"]
    s.executables = ["alpha-tool"]
    s.bindir = "bin"
    s.require_paths = ["lib"]
  end
  SPEC

# The checkout layout of `fixtures/differential/git-glob`: the gemspecs live
# two levels down (`gems/<name>/<name>.gemspec`), out of reach of the default
# `{,*,*/*}.gemspec` but matched by the source-declared `gems/*/*.gemspec`.
private def git_glob_checkout(dir : String) : String
  Dir.mkdir_p(File.join(dir, "gems", "alpha"))
  Dir.mkdir_p(File.join(dir, "bin"))
  File.write(File.join(dir, "gems", "alpha", "alpha.gemspec"), GIT_GLOB_GEMSPEC)
  File.write(File.join(dir, "bin", "alpha-tool"), "#!/usr/bin/env ruby\nputs 'alpha ok'\n")
  dir
end

private def git_glob_index : String
  file_source_url(File.expand_path(File.join(__DIR__, "..", "fixtures", "gem-index")))
end

private def git_glob_available? : Bool
  Process.run("git", ["--version"], output: IO::Memory.new, error: IO::Memory.new).success?
rescue
  false
end

private def git_glob_run(dir : String, args : Array(String)) : String
  output = IO::Memory.new
  errors = IO::Memory.new
  status = Process.run("git", args, chdir: dir, output: output, error: errors)
  raise "git #{args.join(" ")} failed in #{dir}: #{errors.to_s.chomp}" unless status.success?
  output.to_s
end

private def git_glob_init_repo(dir : String) : Nil
  Dir.mkdir_p(dir)
  git_glob_run(dir, ["init", "-q", "-b", "master"])
  git_glob_run(dir, ["config", "user.email", "spec@example.test"])
  git_glob_run(dir, ["config", "user.name", "Spec"])
  git_glob_run(dir, ["config", "commit.gpgsign", "false"])
  git_glob_run(dir, ["add", "-A"])
  git_glob_run(dir, ["commit", "-q", "-m", "mono"])
end

private def with_git_glob_env(dir : String, & : ->) : Nil
  keys = {"HOME", "USERPROFILE", "GEM_HOME", "GEM_PATH", "BUNDLE_PATH", "BUNDLE_APP_CONFIG",
          "BUNDLE_GEMFILE", "CELERITE_BRIDGE_SERVER", "CELERITE_PROFILE_BUNDLER_VERSION"}
  saved = keys.map { |key| {key, ENV[key]?} }
  home = File.join(dir, "home")
  Dir.mkdir_p(home)
  ENV["HOME"] = home
  ENV["USERPROFILE"] = home
  ENV.delete("GEM_HOME")
  ENV.delete("GEM_PATH")
  ENV["BUNDLE_PATH"] = File.join(dir, "bundle")
  ENV["BUNDLE_APP_CONFIG"] = File.join(dir, ".bundle")
  ENV["CELERITE_BRIDGE_SERVER"] = File.expand_path("../assets/bridge/server.rb", __DIR__)
  ENV["CELERITE_PROFILE_BUNDLER_VERSION"] = "4.0.24"
  begin
    yield
  ensure
    saved.each { |key, value| value.nil? ? ENV.delete(key) : (ENV[key] = value) }
  end
end

describe "git source glob" do
  it "loads the gemspec through the glob the source declared" do
    dir = File.tempname("celerite-git-glob", "checkout")
    Dir.mkdir_p(dir)
    install_root = File.tempname("celerite-git-glob", "root")
    begin
      checkout = git_glob_checkout(dir)
      with_client do |client|
        installer = Celerite::Installer.new(install_root, "4.0.0", client,
          Celerite::Downloader.new("https://example.test", File.join(dir, "cache")), IO::Memory.new)

        installer.install_source_gem("alpha", "0.1.0", nil, checkout, "gems/*/*.gemspec").should be_true
        stub = File.join(install_root, "bin", "alpha-tool")
        File.file?(stub).should be_true
        File.read(stub).should contain("This file was generated by RubyGems.")
      end
    ensure
      FileUtils.rm_rf(dir)
      FileUtils.rm_rf(install_root)
    end
  end

  it "returns false instead of raising when no gemspec matches the glob" do
    dir = File.tempname("celerite-git-glob", "miss")
    Dir.mkdir_p(dir)
    install_root = File.tempname("celerite-git-glob", "miss-root")
    begin
      checkout = git_glob_checkout(dir)
      with_client do |client|
        installer = Celerite::Installer.new(install_root, "4.0.0", client,
          Celerite::Downloader.new("https://example.test", File.join(dir, "cache")), IO::Memory.new)

        # The default `{,*,*/*}.gemspec` cannot see `gems/alpha/alpha.gemspec`;
        # the reference tolerates a checkout with nothing to install
        # (`source/path/installer.rb:32`) instead of aborting the install.
        installer.install_source_gem("alpha", "0.1.0", nil, checkout).should be_false
        File.exists?(File.join(install_root, "bin", "alpha-tool")).should be_false

        # A sibling gem must not be installed under the requested name either.
        installer.install_source_gem("beta", "0.1.0", nil, checkout, "gems/*/*.gemspec").should be_false
      end
    ensure
      FileUtils.rm_rf(dir)
      FileUtils.rm_rf(install_root)
    end
  end

  it "resolves and installs a git source gem through the declared glob" do
    pending! "git is not available" unless git_glob_available?
    dir = File.tempname("celerite-git-glob", "proj")
    Dir.mkdir_p(dir)
    begin
      with_git_glob_env(dir) do
        with_project({
          "mono/gems/alpha/alpha.gemspec" => GIT_GLOB_GEMSPEC,
          "mono/bin/alpha-tool"           => "#!/usr/bin/env ruby\nputs 'alpha ok'\n",
          "Gemfile"                       => %(source "#{git_glob_index}"\n\ngem "alpha", git: "./mono", glob: "gems/*/*.gemspec"\n),
        }) do |project|
          ENV["BUNDLE_GEMFILE"] = File.join(project, "Gemfile")
          git_glob_init_repo(File.join(project, "mono"))

          code, _out, err = run_cli(["install"])
          code.should eq(0)
          err.should_not contain("no gemspec")

          lock = File.read(File.join(project, "Gemfile.lock"))
          lock.should contain("glob: gems/*/*.gemspec")
          lock.should contain("    alpha (0.1.0)\n")

          # Crystal's `Dir.glob` only matches forward slashes on Windows, so a
          # `File.join`-built pattern silently returns nothing there.
          # Only the bundle bin dir holds the binstub; the checkout below
          # `bundler/gems/<name>-<rev>/bin` is the source's own script.
          stubs = Dir.glob(dir.tr("\\", "/") + "/bundle/ruby/*/bin/alpha-tool")
          stubs.size.should eq(1)
          File.read(stubs.first).should contain("This file was generated by RubyGems.")
        end
      end
    ensure
      FileUtils.rm_rf(dir)
    end
  end
end
