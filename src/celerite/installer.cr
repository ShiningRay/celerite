require "./tar"
require "./downloader"
require "./bridge/client"
require "./gem/platform"
require "./errors"
require "file_utils"

module Celerite
  # Installs resolved gems into the bundle path with the reference tree
  # layout: `<path>/ruby/<abi>/{cache,gems,specifications,bin,extensions}`
  # (pinned observation from the reference oracle). Writes happen into
  # per-gem temp directories and are renamed into place atomically.
  class Installer
    getter install_path : String
    getter ruby_abi : String
    getter downloader : Downloader
    property config : Config?
    property target_rbconfig : String?

    def initialize(@install_path : String, @ruby_abi : String, @bridge : Bridge::Client,
                   @downloader : Downloader, progress : IO)
      @progress = progress
      @install_root = File.join(install_path, "ruby", ruby_abi)
    end

    private def config_build_args(name : String) : Array(String)?
      cfg = @config
      return nil unless cfg
      value = cfg["build.#{name}"]
      return nil if value.nil? || value == ""
      value.to_s.split(" ").reject(&.empty?)
    end

    def installed?(name : String, version : String, platform : String?) : Bool
      full_name = (platform.nil? || platform == "ruby") ? "#{name}-#{version}" : "#{name}-#{version}-#{platform}"
      spec_path = File.join(@install_root, "specifications", "#{full_name}.gemspec")
      gem_dir = File.join(@install_root, "gems", full_name)
      File.file?(spec_path) && Dir.exists?(gem_dir)
    end

    # Installs one gem; skips when already installed (idempotent parity).
    # Returns true when work was done.
    def install(name : String, version : String, platform : String?, checksum : String?, force : Bool = false) : Bool
      return false if installed?(name, version, platform) && !force

      full_name = (platform.nil? || platform == "ruby") ? "#{name}-#{version}" : "#{name}-#{version}-#{platform}"

      gem_file = @downloader.fetch(name, version, platform, checksum)
      install_file(gem_file, name, version, platform, full_name)
    end

    # Reinstalls an installed gem from its cached package (pristine). The
    # package is re-downloaded when the install cache no longer holds it.
    def reinstall(name : String, version : String, platform : String?, checksum : String?) : Nil
      full_name = (platform.nil? || platform == "ruby") ? "#{name}-#{version}" : "#{name}-#{version}-#{platform}"
      cached = File.join(@install_root, "cache", "#{full_name}.gem")
      gem_file = if File.file?(cached)
                   cached
                 else
                   @downloader.fetch(name, version, platform, checksum)
                 end

      remove_installed(name, version, platform, gem_file)
      install_file(gem_file, name, version, platform, full_name)
    end

    # Removes the installed artifacts for a gem before a pristine reinstall.
    def remove_installed(name : String, version : String, platform : String?, gem_file : String?) : Nil
      full_name = (platform.nil? || platform == "ruby") ? "#{name}-#{version}" : "#{name}-#{version}-#{platform}"
      FileUtils.rm_rf(File.join(@install_root, "gems", full_name))
      FileUtils.rm_rf(File.join(@install_root, "extensions", Gem::Platform.local.to_s, @ruby_abi, full_name))
      spec_path = File.join(@install_root, "specifications", "#{full_name}.gemspec")
      File.delete(spec_path) if File.file?(spec_path)
      if gem_file && File.file?(gem_file)
        info = read_spec(gem_file)
        bindir = File.join(@install_root, "bin")
        info.executables.each do |executable|
          path = File.join(bindir, executable)
          File.delete(path) if File.file?(path)
          bat = File.join(bindir, "#{executable}.bat")
          File.delete(bat) if File.file?(bat)
        end
      end
    end

    private def install_file(gem_file : String, name : String, version : String,
                             platform : String?, full_name : String) : Bool
      read_spec(gem_file)

      # extraction root (temp, renamed per part at the end)
      work = File.join(@install_root, ".celerite-install-#{Process.pid}-#{rand(1 << 30)}")
      gem_dir = File.join(work, "gems", full_name)
      cache_dir = File.join(work, "cache")
      spec_dir = File.join(work, "specifications")
      bin_dir = File.join(work, "bin")
      Dir.mkdir_p(gem_dir)
      Dir.mkdir_p(cache_dir)
      Dir.mkdir_p(spec_dir)

      begin
        # cache copy + payload extraction
        FileUtils.cp(gem_file, File.join(cache_dir, "#{full_name}.gem"))
        extract_payload(gem_file, gem_dir)

        # installed specification (Marshal, written by the Ruby bridge)
        spec_destination = File.join(spec_dir, "#{full_name}.gemspec")
        written = Bridge::WrittenSpec.from_json(
          @bridge.write_installed_spec(gem_file, spec_destination, gem_dir).to_json
        )

        # executables: RubyGems-compatible wrappers generated by the bridge so
        # the bin tree matches the reference (app script + Windows .bat stub).
        unless written.executables.empty?
          Dir.mkdir_p(bin_dir)
          result = @bridge.generate_bin_stubs(gem_file, bin_dir, gem_dir)
          if result["error"]?
            raise Error.new("bin stub generation failed for #{full_name}: #{result["error"].as_s}")
          end
        end

        # publish atomically: move each part into place
        target_cache = File.join(@install_root, "cache")
        target_gems = File.join(@install_root, "gems")
        target_specs = File.join(@install_root, "specifications")
        target_bin = File.join(@install_root, "bin")
        FileUtils.mkdir_p(target_cache)
        FileUtils.mkdir_p(target_gems)
        FileUtils.mkdir_p(target_specs)

        # Windows renames fail over existing directories; clear stale targets
        # from interrupted installs first.
        target_gem_file = File.join(target_cache, "#{full_name}.gem")
        File.delete(target_gem_file) if File.file?(target_gem_file)
        FileUtils.rm_rf(File.join(target_gems, full_name))
        File.rename(File.join(cache_dir, "#{full_name}.gem"), target_gem_file)
        File.rename(gem_dir, File.join(target_gems, full_name))

        # native extensions (Ruby toolchain via the bridge, architecture §2.1)
        unless written.extensions.empty?
          extension_dir = File.join(@install_root, "extensions", Gem::Platform.local.to_s,
            @ruby_abi, full_name)
          build_args = config_build_args(name)
          build_result = @bridge.build_extension(
            File.join(target_gems, full_name), extension_dir, name, gem_file, target_rbconfig, build_args
          )
          if build_result["error"]?
            raise Error.new("extension build failed for #{full_name}: #{build_result["error"].as_s}")
          end
        end

        target_spec = File.join(target_specs, "#{full_name}.gemspec")
        File.delete(target_spec) if File.file?(target_spec)
        File.rename(spec_destination, target_spec)
        if Dir.exists?(bin_dir) && !Dir.empty?(bin_dir)
          FileUtils.mkdir_p(target_bin)
          Dir.children(bin_dir).each do |child|
            File.rename(File.join(bin_dir, child), File.join(target_bin, child))
          end
        end

        true
      rescue ex
        # Failure cleanup: no partially installed artifact may satisfy
        # `installed?` after a failed extraction/extension build.
        clean_partial(name, version, platform, full_name)
        raise ex
      ensure
        FileUtils.rm_rf(work)
      end
    end

    private def clean_partial(name : String, version : String, platform : String?, full_name : String) : Nil
      FileUtils.rm_rf(File.join(@install_root, "gems", full_name))
      FileUtils.rm_rf(File.join(@install_root, "extensions", Gem::Platform.local.to_s, @ruby_abi, full_name))
      spec_path = File.join(@install_root, "specifications", "#{full_name}.gemspec")
      File.delete(spec_path) if File.file?(spec_path)
    end

    # PATH/GIT source gems are not downloaded; the reference leaves the
    # source checkout in place and materializes only its executable stubs
    # in the bundle bin directory (pinned by `exec-loader`).
    def install_source_gem(name : String, version : String, platform : String?, source_dir : String) : Bool
      full_name = (platform.nil? || platform == "ruby") ? "#{name}-#{version}" : "#{name}-#{version}-#{platform}"
      info = Bridge::GemSpecInfo.from_json(@bridge.load_gemspec_dir(source_dir).to_json)
      return false if info.executables.empty?

      target_bin = File.join(@install_root, "bin")
      Dir.mkdir_p(target_bin)
      bindir = info.bindir.empty? ? "bin" : info.bindir
      info.executables.each do |executable|
        source = File.join(source_dir, bindir, executable)
        next unless File.file?(source)
        stub_path = File.join(target_bin, executable)
        File.write(stub_path, rubygems_executable_stub(name, executable))
        File.chmod(stub_path, 0o755) unless windows?
        File.write("#{stub_path}.bat", rubygems_windows_stub) if windows?
      end
      true
    end

    private def windows? : Bool
      {% if flag?(:windows) %}
        true
      {% else %}
        false
      {% end %}
    end

    private def read_spec(gem_file : String) : Bridge::GemSpecInfo
      Bridge::GemSpecInfo.from_json(@bridge.read_gem_spec(gem_file).to_json)
    end

    # Extracts `data.tar.gz` from the .gem into destination.
    private def extract_payload(gem_file : String, destination : String) : Nil
      File.open(gem_file, "rb") do |io|
        Tar.each_entry(io) do |entry, data|
          next unless entry.name == "data.tar.gz"
          payload = data.not_nil!
          Tar.each_gzip_entry(payload) do |file_entry, file_data|
            destination_entry = File.expand_path(file_entry.name, destination)
            unless destination_entry.starts_with?(File.expand_path(destination))
              raise Error.new("path traversal in gem payload: #{file_entry.name}")
            end
            if file_entry.directory
              Dir.mkdir_p(destination_entry)
            else
              parent = File.dirname(destination_entry)
              Dir.mkdir_p(parent)
              File.write(destination_entry, file_data.not_nil!.gets_to_end)
            end
          end
          return
        end
      end
      raise Error.new("gem package has no data.tar.gz: #{gem_file}")
    end

    # RubyGems-style executable wrapper used for PATH/GIT source gem binstubs.
    private def rubygems_executable_stub(name : String, executable : String) : String
      <<-STUB
      #! ruby
      #
      # This file was generated by RubyGems.
      #
      # The application '#{name}' is installed as part of a gem, and
      # this file is here to facilitate running it.
      #

      require 'rubygems'

      Gem.use_gemdeps

      version = ">= 0.a"

      str = ARGV.first
      if str
        str = str.b[/\\A_(.*)_\\z/, 1]
        if str and Gem::Version.correct?(str)
          version = str
          ARGV.shift
        end
      end

      if Gem.respond_to?(:activate_and_load_bin_path)
        Gem.activate_and_load_bin_path('#{name}', '#{executable}', version)
      else
        load Gem.activate_bin_path('#{name}', '#{executable}', version)
      end
      STUB
    end

    # RubyGems Windows batch stub (CRLF) for source gem executables.
    private def rubygems_windows_stub : String
      "@ECHO OFF\r\n@ruby.exe \"%~dpn0\" %*\r\n"
    end
  end
end
